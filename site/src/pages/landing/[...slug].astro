---
// Catch-all для всех Plasmic-страниц.
// URL: /landing/<slug>/  где <slug> = path страницы в Plasmic Studio.
// При build: тянем список всех страниц из Plasmic, рендерим каждую как SSG.
//
// Если страница в Plasmic называется "Homepage" с URL path "/" — она будет на /landing/.
// Если "About" с URL path "/about" — будет на /landing/about/.

import Base from '../../layouts/Base.astro';
import PlasmicPage from '../../components/react/PlasmicPage';
import { PLASMIC } from '../../lib/plasmic';

export async function getStaticPaths() {
  // Если ключи не заданы — возвращаем пусто, страниц не будет
  if (!process.env.PLASMIC_PROJECT_ID || !process.env.PLASMIC_API_TOKEN) {
    return [];
  }

  // Plasmic возвращает все опубликованные страницы из проекта
  const pageModules = await PLASMIC.fetchPages();

  return Promise.all(
    pageModules.map(async (mod) => {
      // path в Plasmic типа "/" или "/about" — нормализуем в slug
      const rawPath = mod.path.replace(/^\/+/, '').replace(/\/+$/, '');
      const slug = rawPath === '' ? undefined : rawPath;

      // Префетчим контент страницы — он вшивается в HTML на build
      const prefetchedData = await PLASMIC.fetchComponentData(mod.path);

      return {
        params: { slug },
        props: {
          componentName: mod.path,
          prefetchedData,
          title: mod.name,
        },
      };
    })
  );
}

const { componentName, prefetchedData, title } = Astro.props;
---

<Base
  title={`${title} — MY AVTO`}
  description={`${title} — запчасти для капитального ремонта двигателя в Алматы.`}
>
  <PlasmicPage
    client:load
    componentName={componentName}
    prefetchedData={prefetchedData}
  />
</Base>
