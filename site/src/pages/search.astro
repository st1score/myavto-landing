---
import Base from '../layouts/Base.astro';
import SearchPage from '../components/react/SearchPage.tsx';

const title = 'Каталог · MY AVTO';
const description = 'Поиск по поршням, кольцам, вкладышам, гильзам и ремкомплектам. По OEM, артикулу, двигателю или авто.';
---
<Base title={title} description={description} noindex={true}>
  <section class="searchpg-section">
    <div class="container">
      <SearchPage client:load />
    </div>
  </section>
</Base>

<style>
  .searchpg-section { padding: 32px 0 64px; }
  @media (max-width: 768px) { .searchpg-section { padding: 16px 0 48px; } }

  :global(.searchpg-bar) {
    display: flex; gap: 16px; align-items: center; flex-wrap: wrap;
    margin-bottom: 24px;
  }
  :global(.searchpg-q) {
    flex: 1; min-width: 260px;
    padding: 14px 18px;
    border: 2px solid var(--c-black);
    border-radius: 12px;
    font: inherit; font-size: 1.05rem;
    background: #fff;
    outline: 0;
  }
  :global(.searchpg-q:focus) { box-shadow: 0 6px 24px rgba(10,10,10,0.08); }
  :global(.searchpg-toggle) {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 16px; background: var(--c-bg-soft);
    border-radius: 999px; cursor: pointer; user-select: none;
    font-size: .9rem; font-weight: 500;
  }

  :global(.searchpg-layout) {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 28px;
    align-items: start;
  }
  @media (max-width: 900px) {
    :global(.searchpg-layout) { grid-template-columns: 1fr; }
    :global(.searchpg-filters) { order: 2; }
  }

  :global(.searchpg-filters) {
    position: sticky; top: 80px;
    padding: 20px;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    display: flex; flex-direction: column; gap: 20px;
  }
  @media (max-width: 900px) { :global(.searchpg-filters) { position: static; max-height: none; } }
  :global(.fg-title) { font-size: .78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-text-dim); font-weight: 600; margin-bottom: 8px; }
  :global(.fg-search) {
    width: 100%; padding: 8px 10px;
    border: 1px solid var(--c-border); border-radius: 8px;
    font: inherit; font-size: .88rem; margin-bottom: 8px;
  }
  :global(.fg-options) { display: flex; flex-wrap: wrap; gap: 6px; }
  :global(.fg-opt) {
    padding: 6px 10px;
    background: var(--c-bg-soft); border: 1px solid var(--c-border);
    border-radius: 999px; font-size: .82rem; cursor: pointer;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    transition: all var(--t-fast);
  }
  :global(.fg-opt:hover) { border-color: var(--c-black); background: #fff; }
  :global(.fg-clear) {
    padding: 6px 10px; background: var(--c-black); color: #fff;
    border: 0; border-radius: 999px; font-size: .82rem;
    cursor: pointer; font-weight: 600;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }
  :global(.searchpg-reset) {
    margin-top: 8px;
    padding: 10px; background: transparent; border: 1px solid var(--c-border);
    border-radius: 10px; cursor: pointer; font-weight: 600;
  }
  :global(.searchpg-reset:hover) { border-color: var(--c-red); color: var(--c-red); }

  :global(.searchpg-count) { font-size: .9rem; color: var(--c-text-dim); margin-bottom: 16px; }

  :global(.searchpg-grid) {
    display: grid; gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }

  :global(.pcard) {
    display: flex; flex-direction: column; gap: 0;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    overflow: hidden;
    transition: all var(--t-med);
    color: var(--c-text);
  }
  :global(.pcard:hover) {
    transform: translateY(-3px); border-color: var(--c-black);
    box-shadow: var(--shadow-lg); color: var(--c-text);
  }
  :global(.pcard-img) {
    aspect-ratio: 4 / 3;
    background: var(--c-bg-soft);
    display: flex; align-items: center; justify-content: center;
  }
  :global(.pcard-img img) { width: 100%; height: 100%; object-fit: contain; padding: 12px; }
  :global(.pcard-img-fallback) {
    font-size: 2.2rem; font-weight: 800; color: var(--c-text-faint);
    width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
  }
  :global(.pcard-body) { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px; }
  :global(.pcard-brand) { font-size: .78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-text-dim); font-weight: 600; display: flex; align-items: center; gap: 6px; }
  :global(.pcard-dot) { color: var(--c-success); }
  :global(.pcard-title) { font-size: .98rem; font-weight: 600; line-height: 1.3; margin: 0; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  :global(.pcard-meta) { display: flex; flex-wrap: wrap; gap: 8px; font-size: .82rem; color: var(--c-text-dim); }
  :global(.pcard-oem) { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: .78rem; color: var(--c-text-faint); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.pcard-price) { font-weight: 700; font-size: 1.05rem; margin-top: 4px; }

  :global(.searchpg-empty) {
    padding: 60px 20px; text-align: center;
    color: var(--c-text-dim); font-size: 1.02rem;
    background: var(--c-bg-soft); border-radius: var(--r-md);
  }
  :global(.searchpg-empty a) { color: var(--c-red); font-weight: 600; }
  :global(.searchpg-more) {
    display: block; margin: 24px auto 0;
    padding: 12px 24px;
    background: transparent; border: 2px solid var(--c-black);
    border-radius: 10px; cursor: pointer; font-weight: 700;
  }
  :global(.searchpg-more:hover) { background: var(--c-black); color: #fff; }
</style>
