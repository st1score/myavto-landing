---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const title = 'Поиск запчастей по артикулу или коду двигателя — MY AVTO Алматы';
const description = 'Введите артикул TEIKIN, OEM-номер или код двигателя — найдём подходящие поршни и кольца из каталога MY AVTO в Алматы.';
---
<Base title={title} description={description} noindex>
  <div class="container poisk-page">
    <Breadcrumbs items={[{ name: 'Главная', href: '/' }, { name: 'Поиск' }]} />
    <h1 id="searchH1">Поиск по артикулу или двигателю</h1>
    <p class="poisk-lead">Введите артикул с поршня (TEIKIN или OEM) или код двигателя — найдём подходящие позиции и подскажем наличие.</p>

    <form class="poisk-form" action="/poisk/" method="get" id="poiskForm">
      <div class="pf-input-wrap">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input
          type="search"
          name="q"
          id="poiskInput"
          placeholder="13101-67050, 46283 или 1KZ"
          autocomplete="off"
          autofocus
        />
      </div>
      <button type="submit" class="btn">Искать</button>
    </form>

    <div class="poisk-filters" id="poiskFilters" hidden>
      <div class="pf-group" data-group="type">
        <button type="button" class="pf-chip active" data-val="">Все</button>
        <button type="button" class="pf-chip" data-val="e">Двигатели</button>
        <button type="button" class="pf-chip" data-val="a">Артикулы</button>
      </div>
      <div class="pf-group" data-group="cat">
        <button type="button" class="pf-chip active" data-val="">Все категории</button>
        <button type="button" class="pf-chip" data-val="PISTON">Поршни</button>
        <button type="button" class="pf-chip" data-val="RING">Кольца</button>
      </div>
    </div>

    <p class="muted" id="poiskHint">Например: <a href="/poisk/?q=1KZ">1KZ</a>, <a href="/poisk/?q=46283">46283</a>, <a href="/poisk/?q=13101-67050">13101-67050</a>.</p>

    <div id="poiskCount" class="poisk-count" hidden></div>
    <div id="poiskResults" class="poisk-grid"></div>

    <div class="poisk-fallback">
      <h2>Не нашли нужный артикул?</h2>
      <p>Напишите номер с поршня или код двигателя — менеджер ответит за 15 минут в рабочее время и подберёт подходящий вариант.</p>
      <a id="poiskWaBtn" href="https://wa.me/77015509377?text=Здравствуйте!%20Не%20нашёл%20нужный%20артикул%20на%20сайте,%20помогите%20с%20подбором." target="_blank" rel="noopener noreferrer" class="btn">Написать в WhatsApp</a>
    </div>
  </div>
</Base>

<style is:global>
  .poisk-page { padding: 24px 0 80px; }
  .poisk-page h1 { margin: 16px 0 8px; font-size: clamp(1.6rem, 4vw, 2.2rem); font-weight: 800; }
  .poisk-lead { color: var(--c-text-faint); margin-bottom: 20px; max-width: 720px; }

  .poisk-form {
    display: flex;
    gap: 10px;
    margin-bottom: 16px;
    max-width: 720px;
  }
  .pf-input-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: 12px;
    transition: border-color var(--t-fast), box-shadow var(--t-fast);
  }
  .pf-input-wrap:focus-within { border-color: var(--c-red); box-shadow: 0 0 0 3px rgba(229,9,20,0.08); }
  .pf-input-wrap svg { color: var(--c-text-faint); flex-shrink: 0; }
  .pf-input-wrap input {
    flex: 1;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 1rem;
    color: var(--c-text);
    min-width: 0;
  }
  .poisk-form .btn { padding: 14px 24px; flex-shrink: 0; }
  @media (max-width: 640px) { .poisk-form .btn { padding: 14px 18px; } }

  .poisk-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-bottom: 20px;
  }
  .pf-group { display: flex; flex-wrap: wrap; gap: 6px; }
  .pf-chip {
    padding: 6px 14px;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: 999px;
    font-size: .88rem;
    color: var(--c-text);
    cursor: pointer;
    transition: all var(--t-fast);
  }
  .pf-chip:hover { border-color: var(--c-red); color: var(--c-red); }
  .pf-chip.active { background: var(--c-red); color: #fff; border-color: var(--c-red); }

  #poiskHint { margin-bottom: 20px; font-size: .92rem; }
  #poiskHint a { color: var(--c-red); font-weight: 600; }

  .poisk-count {
    margin-bottom: 16px;
    color: var(--c-text-faint);
    font-size: .9rem;
  }
  .poisk-count strong { color: var(--c-text); }

  .poisk-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 14px;
    margin-bottom: 32px;
  }

  .poisk-card {
    display: flex;
    gap: 14px;
    padding: 14px;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: 14px;
    text-decoration: none;
    color: var(--c-text);
    transition: border-color var(--t-fast), transform var(--t-fast), box-shadow var(--t-fast);
    min-height: 96px;
  }
  .poisk-card:hover {
    border-color: var(--c-red);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(15,23,42,0.08);
  }
  .pc-img {
    width: 84px;
    height: 84px;
    flex-shrink: 0;
    background: var(--c-bg-soft, #f5f5f7);
    border-radius: 10px;
    object-fit: contain;
    padding: 6px;
  }
  .pc-img-placeholder {
    width: 84px;
    height: 84px;
    flex-shrink: 0;
    background: var(--c-bg-soft, #f5f5f7);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-text-faint);
    font-size: 1.6rem;
  }
  .pc-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pc-tag-row { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .pc-tag {
    padding: 2px 8px;
    border-radius: 999px;
    font-size: .68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .pc-tag.engine { background: #e0f2fe; color: #0369a1; }
  .pc-tag.article { background: #fef3c7; color: #92400e; }
  .pc-tag.cat { background: #f1f5f9; color: #475569; }
  .pc-label {
    font-weight: 700;
    font-size: 1.05rem;
    word-break: break-all;
    line-height: 1.2;
  }
  .pc-sub {
    color: var(--c-text-faint);
    font-size: .88rem;
    line-height: 1.35;
  }
  .pc-arrow {
    align-self: center;
    color: var(--c-text-faint);
    flex-shrink: 0;
    font-size: 1.4rem;
  }
  .poisk-card:hover .pc-arrow { color: var(--c-red); }

  .poisk-empty {
    grid-column: 1 / -1;
    padding: 40px 24px;
    text-align: center;
    background: var(--c-bg-soft, #f5f5f7);
    border-radius: 14px;
    color: var(--c-text-faint);
  }
  .poisk-empty strong { color: var(--c-text); display: block; margin-bottom: 8px; }

  .poisk-fallback {
    padding: 32px 24px;
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
    color: #fff;
    border-radius: 16px;
    text-align: center;
  }
  .poisk-fallback h2 { font-size: 1.4rem; margin-bottom: 8px; }
  .poisk-fallback p { color: rgba(255,255,255,0.7); margin-bottom: 18px; max-width: 540px; margin-left: auto; margin-right: auto; }
</style>

<script>
  (() => {
    const input = document.getElementById('poiskInput') as HTMLInputElement | null;
    const results = document.getElementById('poiskResults');
    const hint = document.getElementById('poiskHint');
    const h1 = document.getElementById('searchH1');
    const filters = document.getElementById('poiskFilters');
    const countEl = document.getElementById('poiskCount');
    const waBtn = document.getElementById('poiskWaBtn') as HTMLAnchorElement | null;
    if (!input || !results || !hint || !h1 || !filters || !countEl || !waBtn) return;

    type Item = {
      t: 'e' | 'a';
      q: string; l: string; s: string; u: string;
      b?: string; i?: string; nt?: string; c?: 'PISTON' | 'RING';
    };
    let index: Item[] | null = null;
    let lastQuery = '';
    let lastResults: Item[] = [];
    let filterType: '' | 'e' | 'a' = '';
    let filterCat: '' | 'PISTON' | 'RING' = '';

    function normalize(s: string): string { return s.toLowerCase().replace(/[\s\-]/g, ''); }

    function search(q: string, idx: Item[]): Item[] {
      const nq = normalize(q);
      if (nq.length < 2) return [];
      const exact: Item[] = [];
      const starts: Item[] = [];
      const contains: Item[] = [];
      for (const it of idx) {
        if (it.q === nq) exact.push(it);
        else if (it.q.startsWith(nq)) starts.push(it);
        else if (it.q.includes(nq)) contains.push(it);
      }
      return [...exact, ...starts, ...contains].slice(0, 60);
    }

    function applyFilters(items: Item[]): Item[] {
      return items.filter((it) => {
        if (filterType && it.t !== filterType) return false;
        if (filterCat && it.c !== filterCat) return false;
        return true;
      });
    }

    function esc(s: string): string {
      return s.replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c] as string));
    }

    function renderCard(it: Item): string {
      const tag = it.t === 'e'
        ? '<span class="pc-tag engine">Двигатель</span>'
        : '<span class="pc-tag article">Артикул</span>';
      const catTag = it.c === 'PISTON' ? '<span class="pc-tag cat">Поршни</span>'
        : it.c === 'RING' ? '<span class="pc-tag cat">Кольца</span>' : '';
      const img = it.i
        ? `<img src="${esc(it.i)}" alt="" class="pc-img" loading="lazy">`
        : `<div class="pc-img-placeholder">${it.t === 'e' ? '⚙️' : '🔧'}</div>`;
      return `<a class="poisk-card" href="${esc(it.u)}">
        ${img}
        <div class="pc-body">
          <div class="pc-tag-row">${tag}${catTag}</div>
          <div class="pc-label">${esc(it.l)}</div>
          <div class="pc-sub">${esc(it.s)}</div>
        </div>
        <span class="pc-arrow">›</span>
      </a>`;
    }

    function render(query: string) {
      const filtered = applyFilters(lastResults);
      if (filtered.length === 0) {
        results!.innerHTML = `<div class="poisk-empty"><strong>Ничего не найдено по запросу «${esc(query)}»</strong>Попробуйте другой артикул, проверьте опечатки или напишите нам в WhatsApp — поможем подобрать.</div>`;
        countEl!.hidden = true;
        return;
      }
      countEl!.hidden = false;
      countEl!.innerHTML = `Найдено: <strong>${filtered.length}</strong> ${filtered.length !== lastResults.length ? `(из ${lastResults.length})` : ''}`;
      results!.innerHTML = filtered.map(renderCard).join('');
    }

    async function loadAndSearch(q: string) {
      lastQuery = q;
      if (!q || q.length < 2) {
        results!.innerHTML = '';
        hint!.style.display = '';
        filters!.hidden = true;
        countEl!.hidden = true;
        h1!.textContent = 'Поиск по артикулу или двигателю';
        return;
      }
      hint!.style.display = 'none';
      h1!.textContent = `Поиск: «${q}»`;
      waBtn!.href = `https://wa.me/77015509377?text=${encodeURIComponent(`Здравствуйте! Ищу артикул «${q}» — помогите подобрать.`)}`;

      if (!index) {
        results!.innerHTML = '<div class="poisk-empty">Загрузка…</div>';
        try {
          const r = await fetch('/search-index.json');
          const data = await r.json();
          index = data.items as Item[];
        } catch {
          results!.innerHTML = '<div class="poisk-empty"><strong>Не удалось загрузить индекс.</strong>Обновите страницу или напишите нам в WhatsApp.</div>';
          return;
        }
      }
      lastResults = search(q, index);
      filters!.hidden = lastResults.length === 0;
      render(q);
    }

    // фильтры
    filters.querySelectorAll<HTMLButtonElement>('.pf-chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        const group = btn.parentElement!.dataset.group;
        const val = btn.dataset.val ?? '';
        btn.parentElement!.querySelectorAll('.pf-chip').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        if (group === 'type') filterType = val as '' | 'e' | 'a';
        else if (group === 'cat') filterCat = val as '' | 'PISTON' | 'RING';
        render(lastQuery);
      });
    });

    // initial query from URL
    const params = new URLSearchParams(window.location.search);
    const initialQ = params.get('q')?.trim() ?? '';
    if (initialQ) {
      input.value = initialQ;
      loadAndSearch(initialQ);
    }

    let timer: number | undefined;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => loadAndSearch(input.value.trim()), 150);
    });
  })();
</script>
