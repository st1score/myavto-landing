---
import Base from '../layouts/Base.astro';
import FAQ from '../components/FAQ.astro';
import { CONTACTS } from '../lib/contacts';
import { getEngines, getPistonProductsInStock } from '../lib/db';
import { brandSlug, engineSlug } from '../lib/slugs';
import { partsBrandLabel } from '../lib/labels';
import { teikinCatalog } from '../data/teikin-catalog';

const [engines, stockProducts] = await Promise.all([
  getEngines(),
  getPistonProductsInStock(),
]);

const totalEngines = engines.length;
const popularCodes = ['1KZ', '2JZ', '2GR', '1MZ', '1ZZ', '2AZ', '1GR', 'VQ35DE', '4G63', '4M40'];
const enginesByCode = new Map(engines.map((e) => [e.engine_code, e]));

const categories = [
  { title: 'Поршни', href: '/zapchasti/porshni/', icon: 'engine' },
  { title: 'Кольца', href: '/zapchasti/koltsa-porshnevye/', icon: 'rings' },
  { title: 'Вкладыши', href: '/zapchasti/vkladyshi/', icon: 'bearing' },
  { title: 'Toyota', href: '/toyota/', icon: 'badge' },
  { title: 'Nissan', href: '/nissan/', icon: 'badge' },
  { title: 'Mitsubishi', href: '/mitsubishi/', icon: 'badge' },
  { title: 'Mazda', href: '/mazda/', icon: 'badge' },
  { title: 'Бренды', href: '/brendy/', icon: 'brand' },
];

const SIZE_SLUG: Record<string, string> = {
  STD: 'std',
  '0.25': '025',
  '0.50': '050',
  '0.75': '075',
  '1.00': '100',
};

function productUrl(p: typeof stockProducts[number]) {
  const engine = enginesByCode.get(p.engine_code);
  if (!engine) return '/zapchasti/porshni/';
  const brandSl = brandSlug[engine.brand_name] ?? engine.brand_name.toLowerCase();
  const engSl = engineSlug(engine.engine_code);
  const sizeSl = SIZE_SLUG[p.size_code] ?? 'std';
  const insert = p.insert_type === 'plain' ? '' : `-${p.insert_type.toLowerCase()}`;
  const teikinEntry = teikinCatalog[p.engine_code];
  if (p.parts_brand === 'TEIKIN' && teikinEntry?.teikin_pistons?.[0]) {
    const article = teikinEntry.teikin_pistons[0].toLowerCase().replace(/[^a-z0-9]+/g, '-');
    return `/${brandSl}/dvigateli/${engSl}/porshni/teikin-${article}${insert}-${sizeSl}/`;
  }
  const partsBrand = p.parts_brand.toLowerCase().replace(/[^a-z0-9]+/g, '-');
  return `/${brandSl}/dvigateli/${engSl}/porshni/${partsBrand}${insert}-${sizeSl}/`;
}

function productImage(engineCode: string) {
  return teikinCatalog[engineCode]?.image ?? '/teikin-photos/piston-sample.png';
}

const popularProducts = stockProducts
  .filter((p) => popularCodes.includes(p.engine_code))
  .slice(0, 6)
  .map((p) => ({
    ...p,
    engine: enginesByCode.get(p.engine_code),
    href: productUrl(p),
    image: productImage(p.engine_code),
  }))
  .filter((p) => p.engine);

const popularEngines = popularCodes
  .map((code) => enginesByCode.get(code))
  .filter(Boolean)
  .slice(0, 8);

const waUrl = CONTACTS.whatsappWithText('Здравствуйте! Хочу подобрать запчасти для капиталки двигателя.');
---

<Base
  title="MY AVTO — автозапчасти для капиталки двигателя в Алматы"
  description="Поршни, кольца, вкладыши и прокладки ГБЦ для японских авто. Подбор по артикулу, OEM или коду двигателя. Алматы, ТЦ CarCity, доставка по Казахстану."
  keywords="автозапчасти Алматы, поршни Toyota, кольца поршневые, капиталка двигателя, MY AVTO"
  canonical="/"
  stickyWaText="Здравствуйте! Хочу подобрать запчасти для капиталки двигателя."
>
  <main class="home-shop">
    <section class="home-hero">
      <div class="container home-hero__inner">
        <div class="home-hero__copy">
          <p class="shop-kicker">В наличии · Алматы · доставка по РК</p>
          <h1>Автозапчасти для вашего автомобиля</h1>
          <p class="home-hero__lead">
            Подберём поршни, кольца, вкладыши и прокладки по артикулу, OEM или коду двигателя.
          </p>
          <div class="home-hero__actions">
            <a href="/poisk/" class="btn">Начать покупки</a>
            <a href={waUrl} class="btn btn-ghost" target="_blank" rel="noopener">Подобрать в WhatsApp</a>
          </div>
        </div>
        <div class="home-hero__media" aria-hidden="true">
          <img src="/assets/photos/crankshaft.png" alt="" loading="eager" />
        </div>
      </div>
    </section>

    <section class="shop-section">
      <div class="container">
        <div class="section-row">
          <h2>Категории</h2>
          <a href="/brendy/">Все бренды</a>
        </div>
        <div class="category-grid">
          {categories.map((cat) => (
            <a class="category-tile" href={cat.href}>
              <span class="category-icon" data-icon={cat.icon}></span>
              <span>{cat.title}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="shop-section">
      <div class="container">
        <div class="section-row">
          <h2>Популярные товары</h2>
          <a href="/zapchasti/porshni/">Смотреть все</a>
        </div>
        <div class="product-strip">
          {popularProducts.map((p) => (
            <a class="shop-product-card" href={p.href}>
              <span class="heart" aria-hidden="true">♡</span>
              <img src={p.image} alt={`Поршни ${p.engine?.engine_code}`} loading="lazy" />
              <strong>Поршни {p.engine?.engine_code} {p.size_code}</strong>
              <small>{partsBrandLabel[p.parts_brand] ?? p.parts_brand} · комплект</small>
              <b>от 15 000 ₸</b>
              <span class="stock-dot">В наличии</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="shop-section">
      <div class="container">
        <div class="section-row">
          <h2>Популярные двигатели</h2>
          <span>{totalEngines} в каталоге</span>
        </div>
        <div class="engine-chip-grid">
          {popularEngines.map((engine) => (
            <a class="engine-chip-card" href={`/${brandSlug[engine!.brand_name] ?? engine!.brand_name.toLowerCase()}/dvigateli/${engineSlug(engine!.engine_code)}/`}>
              <img src={productImage(engine!.engine_code)} alt={`Каталог TEIKIN ${engine!.engine_code}`} loading="lazy" />
              <span>
                <strong>{engine!.engine_code}</strong>
                <small>{engine!.brand_name}</small>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="shop-section shop-help">
      <div class="container help-card">
        <div>
          <p class="shop-kicker">Быстро и точно</p>
          <h2>Не знаете код двигателя?</h2>
          <p>Отправьте VIN, марку, модель или фото старой детали. Менеджер проверит артикулы и наличие.</p>
        </div>
        <a href={waUrl} class="btn" target="_blank" rel="noopener">Написать в WhatsApp</a>
      </div>
    </section>

    <section class="shop-section faq-wrap">
      <div class="container">
        <FAQ />
      </div>
    </section>
  </main>
</Base>

<style>
  .home-shop {
    background: #fff;
  }

  .home-hero {
    padding: 28px 0 8px;
  }

  .home-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(340px, 1fr);
    align-items: center;
    gap: 18px;
  }

  .shop-kicker {
    margin: 0 0 12px;
    color: var(--c-red);
    font-size: .8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .home-hero h1 {
    max-width: 520px;
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 4.9rem);
    line-height: .96;
    letter-spacing: 0;
  }

  .home-hero h1::after {
    content: " MYAVTO.kz";
    display: block;
    color: var(--c-red);
    font-size: .42em;
    line-height: 1.2;
    margin-top: 10px;
  }

  .home-hero__lead {
    max-width: 460px;
    margin: 18px 0 0;
    color: var(--c-text-dim);
    font-size: 1.05rem;
  }

  .home-hero__actions {
    display: grid;
    gap: 10px;
    max-width: 420px;
    margin-top: 26px;
  }

  .btn-ghost {
    background: #fff;
    color: var(--c-text);
    border-color: var(--c-border);
    box-shadow: none;
  }

  .btn-ghost:hover {
    background: var(--c-bg-soft);
    color: var(--c-text);
  }

  .home-hero__media {
    min-height: 360px;
    display: flex;
    align-items: end;
    justify-content: center;
    overflow: hidden;
  }

  .home-hero__media img {
    width: min(620px, 100%);
    max-height: 420px;
    object-fit: contain;
    filter: drop-shadow(0 28px 38px rgba(15, 23, 42, .16));
  }

  .shop-section {
    padding: 26px 0;
  }

  .section-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }

  .section-row h2 {
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 2rem);
  }

  .section-row a,
  .section-row span {
    color: var(--c-red);
    font-size: .9rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .category-tile {
    min-height: 126px;
    padding: 18px 12px;
    border: 1px solid var(--c-border);
    border-radius: 14px;
    display: grid;
    place-items: center;
    gap: 12px;
    text-align: center;
    font-size: .9rem;
    font-weight: 700;
    background: linear-gradient(180deg, #fff, #fbfbfc);
  }

  .category-icon {
    width: 34px;
    height: 34px;
    display: block;
    background: var(--c-text);
    mask: var(--icon) center / contain no-repeat;
    -webkit-mask: var(--icon) center / contain no-repeat;
  }

  .category-icon[data-icon="engine"] { --icon: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M7 8h10v8H7zM9 5h6v3H9zM4 11H2v3h2m18-3h-2v3h2M7 12H5v3h2m10-3h2v3h-2M8 18h8' fill='none' stroke='black' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"); }
  .category-icon[data-icon="rings"] { --icon: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='9' cy='12' r='5' fill='none' stroke='black' stroke-width='1.8'/%3E%3Ccircle cx='15' cy='12' r='5' fill='none' stroke='black' stroke-width='1.8'/%3E%3C/svg%3E"); }
  .category-icon[data-icon="bearing"] { --icon: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M5 7h14v10H5zM8 7V5h8v2M8 17v2h8v-2M9 10h6M9 14h6' fill='none' stroke='black' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"); }
  .category-icon[data-icon="badge"] { --icon: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12 3l7 4v6c0 4-3 6.5-7 8-4-1.5-7-4-7-8V7z' fill='none' stroke='black' stroke-width='1.8'/%3E%3Cpath d='M9 12l2 2 4-5' fill='none' stroke='black' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"); }
  .category-icon[data-icon="brand"] { --icon: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12 4l2.2 4.5 5 .7-3.6 3.5.8 5-4.4-2.3-4.4 2.3.8-5L4.8 9.2l5-.7z' fill='none' stroke='black' stroke-width='1.8' stroke-linejoin='round'/%3E%3C/svg%3E"); }

  .product-strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(174px, 1fr);
    gap: 12px;
    overflow-x: auto;
    padding-bottom: 6px;
    scroll-snap-type: x proximity;
  }

  .shop-product-card {
    position: relative;
    min-height: 276px;
    padding: 14px;
    border: 1px solid var(--c-border);
    border-radius: 16px;
    background: #fff;
    display: grid;
    grid-template-rows: 112px auto auto auto auto;
    gap: 6px;
    scroll-snap-align: start;
  }

  .shop-product-card img {
    width: 100%;
    height: 112px;
    object-fit: contain;
  }

  .shop-product-card strong {
    font-size: .92rem;
    line-height: 1.25;
  }

  .shop-product-card small {
    color: var(--c-text-faint);
  }

  .shop-product-card b {
    margin-top: 6px;
    font-size: 1.05rem;
  }

  .heart {
    position: absolute;
    top: 12px;
    right: 12px;
    color: #9ca3af;
    font-size: 1.35rem;
  }

  .stock-dot {
    align-self: end;
    color: #6b7280;
    font-size: .76rem;
  }

  .stock-dot::before {
    content: "";
    width: 7px;
    height: 7px;
    display: inline-block;
    margin-right: 6px;
    border-radius: 50%;
    background: #16a34a;
  }

  .engine-chip-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .engine-chip-card {
    min-height: 92px;
    padding: 12px;
    border: 1px solid var(--c-border);
    border-radius: 16px;
    background: #fff;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .engine-chip-card img {
    width: 58px;
    height: 58px;
    object-fit: contain;
    border-radius: 10px;
    background: var(--c-bg-soft);
  }

  .engine-chip-card strong,
  .engine-chip-card small {
    display: block;
  }

  .engine-chip-card small {
    color: var(--c-text-faint);
  }

  .help-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px;
    border-radius: 18px;
    background: #0a0a0a;
    color: #fff;
  }

  .help-card p:not(.shop-kicker) {
    margin: 8px 0 0;
    color: rgba(255,255,255,.68);
    max-width: 560px;
  }

  .help-card .btn {
    min-width: 220px;
  }

  .faq-wrap {
    padding-top: 8px;
  }

  @media (max-width: 780px) {
    .home-hero {
      padding-top: 14px;
    }

    .home-hero__inner {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
    }

    .home-hero__copy {
      order: 1;
    }

    .home-hero__media {
      order: 2;
      min-height: 190px;
      margin-top: -8px;
    }

    .home-hero__media img {
      max-height: 230px;
      width: 112%;
      max-width: none;
    }

    .home-hero__lead {
      font-size: .98rem;
    }

    .category-grid,
    .engine-chip-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .category-tile {
      min-height: 104px;
      font-size: .82rem;
    }

    .help-card {
      display: grid;
      padding: 24px 18px;
    }

    .help-card .btn {
      width: 100%;
      min-width: 0;
    }
  }
</style>
