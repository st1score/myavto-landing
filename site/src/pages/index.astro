---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/react/SearchBox.tsx';
import TrustSection from '../components/TrustSection.astro';
import { CATEGORY_LABEL } from '../lib/slugs';
import { getPopularEngines } from '../lib/db';

let popularEngines: { engine_code: string; product_count: number }[] = [];
try {
  popularEngines = await getPopularEngines(12);
} catch (e) {
  console.warn('[home] getPopularEngines failed (B5 not applied yet?):', (e as Error).message);
}

const categories: { code: string; emoji: string }[] = [
  { code: 'PISTON',  emoji: '⚙️' },
  { code: 'RING',    emoji: '⭕' },
  { code: 'BEARING', emoji: '🛡' },
  { code: 'LINER',   emoji: '🧱' },
  { code: 'KIT',     emoji: '📦' },
];

const title = 'MY AVTO — запчасти для капремонта двигателя в Алматы';
const description = 'Поршни, кольца, вкладыши, гильзы и ремкомплекты для японских двигателей. TEIKIN, NPR, IZUMI. В наличии в Алматы, доставка по Казахстану.';
---
<Base title={title} description={description}>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Капремонт двигателя · Алматы</span>
      <h1>
        Запчасти для капитального ремонта
        <span class="accent">японских двигателей</span>
      </h1>
      <p class="hero-sub">
        Поршни · Кольца · Вкладыши · Гильзы · Ремкомплекты. Оригинальные бренды TEIKIN, NPR, IZUMI, RIK, Taiho.
      </p>

      <div class="hero-search">
        <SearchBox client:load size="lg" autoFocus={false} />
        <div class="hero-hint">OEM · артикул · двигатель · авто</div>
      </div>

      {popularEngines.length > 0 && (
        <div class="hero-chips" data-stagger>
          <span class="chips-label">Популярные:</span>
          {popularEngines.map((e) => (
            <a href={`/search/?engine=${encodeURIComponent(e.engine_code)}`} class="chip stagger-item">
              {e.engine_code}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="cats-section">
    <div class="container">
      <div class="section-title">
        <h2>Что мы продаём</h2>
        <p>Только детали для капитального ремонта двигателя.</p>
      </div>
      <div class="cats-grid" data-stagger>
        {categories.map((c) => (
          <a href={`/search/?category=${c.code}`} class="cat-tile stagger-item">
            <div class="cat-emoji">{c.emoji}</div>
            <div class="cat-name">{CATEGORY_LABEL[c.code]}</div>
            <div class="cat-arrow">→</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <TrustSection />
</Base>

<style>
  .hero { padding: 80px 0 60px; background: linear-gradient(180deg, #fafafb 0%, #fff 100%); }
  @media (max-width: 768px) { .hero { padding: 48px 0 40px; } }
  .hero h1 { max-width: 880px; }
  .hero h1 .accent { color: var(--c-red); display: inline-block; }
  .hero-sub { max-width: 720px; font-size: 1.12rem; color: var(--c-text-dim); margin-bottom: 32px; }
  @media (max-width: 640px) { .hero-sub { font-size: 1rem; } }

  .hero-search { max-width: 760px; margin: 0 0 24px; }
  .hero-hint { font-size: .82rem; color: var(--c-text-faint); margin-top: 8px; letter-spacing: 0.04em; }

  .hero-chips {
    display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
    margin-top: 32px;
  }
  .chips-label { font-size: .82rem; color: var(--c-text-dim); margin-right: 4px; }
  .chip {
    display: inline-flex; align-items: center;
    padding: 8px 14px;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: 999px;
    font-size: .9rem; font-weight: 600;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    transition: all var(--t-fast);
  }
  .chip:hover { border-color: var(--c-black); background: var(--c-black); color: #fff; }

  .cats-section { padding: 80px 0; }
  @media (max-width: 768px) { .cats-section { padding: 48px 0; } }
  .cats-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }
  @media (max-width: 900px) { .cats-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 540px) { .cats-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }
  .cat-tile {
    position: relative;
    display: flex; flex-direction: column; gap: 8px;
    padding: 28px 20px;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    transition: all var(--t-med);
    overflow: hidden;
  }
  .cat-tile:hover {
    border-color: var(--c-black);
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }
  .cat-emoji { font-size: 2rem; }
  .cat-name { font-weight: 700; font-size: 1.05rem; }
  .cat-arrow { position: absolute; top: 20px; right: 20px; color: var(--c-text-faint); transition: all var(--t-fast); }
  .cat-tile:hover .cat-arrow { color: var(--c-red); transform: translate(3px, -3px); }

  /* SearchBox component styles — global so they apply inside React island. */
  :global(.sb) { position: relative; }
  :global(.sb-input-wrap) {
    display: flex; align-items: center; gap: 8px;
    background: #fff; border: 2px solid var(--c-black); border-radius: 14px;
    padding: 6px 6px 6px 18px;
    transition: border-color var(--t-fast), box-shadow var(--t-fast);
  }
  :global(.sb-input-wrap:focus-within) { box-shadow: 0 6px 24px rgba(10,10,10,0.10); }
  :global(.sb-icon) { color: var(--c-text-faint); flex-shrink: 0; }
  :global(.sb-input-wrap input) {
    flex: 1; min-width: 0;
    border: 0; outline: 0; background: transparent;
    font: inherit; font-size: 1.04rem; padding: 12px 0;
    color: var(--c-text);
  }
  :global(.sb-input-wrap input::placeholder) { color: var(--c-text-faint); }
  :global(.sb-go) {
    flex-shrink: 0;
    padding: 12px 20px;
    background: var(--c-red); color: #fff;
    border: 0; border-radius: 10px;
    font-weight: 700; font-size: .95rem;
    cursor: pointer;
    transition: background var(--t-fast);
  }
  :global(.sb-go:hover) { background: var(--c-red-dark); }
  :global(.sb-lg .sb-input-wrap input) { font-size: 1.1rem; padding: 14px 0; }

  :global(.sb-dropdown) {
    position: absolute; left: 0; right: 0; top: calc(100% + 8px);
    background: #fff; border: 1px solid var(--c-border);
    border-radius: 14px; box-shadow: var(--shadow-lg);
    max-height: 70vh; overflow-y: auto; z-index: 60;
    padding: 6px;
  }
  :global(.sb-hit) {
    display: flex; align-items: center; gap: 12px;
    padding: 10px;
    border-radius: 10px;
    color: var(--c-text);
    transition: background var(--t-fast);
  }
  :global(.sb-hit.active), :global(.sb-hit:hover) { background: var(--c-bg-soft); color: var(--c-text); }
  :global(.sb-hit img) { width: 48px; height: 48px; object-fit: contain; flex-shrink: 0; background: #f7f7f8; border-radius: 8px; }
  :global(.sb-hit-body) { flex: 1; min-width: 0; }
  :global(.sb-hit-title) { font-weight: 600; font-size: .94rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.sb-hit-meta) { font-size: .82rem; color: var(--c-text-dim); display: flex; gap: 6px; align-items: center; }
  :global(.sb-dot) { color: var(--c-success); }
  :global(.sb-hit-price) { font-weight: 700; white-space: nowrap; }
  :global(.sb-more) {
    width: 100%; padding: 12px;
    background: transparent; border: 0; border-top: 1px solid var(--c-border);
    margin-top: 4px;
    font-weight: 600; color: var(--c-red);
    cursor: pointer;
  }
  :global(.sb-more:hover) { background: var(--c-bg-soft); }
</style>
