---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import {
  getEngines,
  getEnginePartsIndex,
  getVariantSizes,
  getStock,
  getPartNumbers,
  getAttributes,
} from '../../../../lib/db';
import { brandSlug, engineSlug, categorySlug } from '../../../../lib/slugs';
import { categoryLabel, brandDisplay } from '../../../../lib/labels';
import { teikinCatalog } from '../../../../data/teikin-catalog';
import { fmtNum } from '../../../../lib/format';
import { brandsForCategory, type PartCategory } from '../../../../lib/parts-brands';
// Цены не выводим — только характеристики, бренды, размеры и артикулы.
// Цены и наличие узнаются через WhatsApp.

export async function getStaticPaths() {
  const engines = await getEngines();
  const partsIdx = await getEnginePartsIndex();
  const engByCode = new Map(engines.map((e) => [e.engine_code, e]));
  return partsIdx
    .map((p) => {
      const eng = engByCode.get(p.engine_code);
      if (!eng) return null;
      const catSl = categorySlug[p.category_code];
      if (!catSl) return null;
      return {
        params: {
          brand: brandSlug[eng.brand_name] ?? eng.brand_name.toLowerCase(),
          engine: engineSlug(eng.engine_code),
          category: catSl,
        },
        props: { engine: eng, categoryCode: p.category_code },
      };
    })
    .filter((x): x is NonNullable<typeof x> => x !== null);
}

const { engine, categoryCode } = Astro.props;
const catLabel = categoryLabel[categoryCode];

const [variants, numbers, attrs, stockItems] = await Promise.all([
  getVariantSizes(engine.engine_code, categoryCode),
  getPartNumbers(engine.engine_code, categoryCode),
  getAttributes(engine.engine_code, categoryCode),
  getStock(engine.engine_code, categoryCode),
]);

// Карта «есть остаток» по комбинации бренд|размер|insert.
// Только для этих комбинаций существуют per-SKU product-страницы.
const inStock = new Set<string>(
  stockItems.filter((s) => s.qty > 0).map((s) => `${s.brand_name}|${s.size_code}|${s.insert_type}`)
);

// Для PISTON: построим URL на product-page как делает /porshni/[product]/index.astro.
const SIZE_SLUG: Record<string, string> = {
  STD: 'std', '0.25': '025', '0.50': '050', '0.75': '075', '1.00': '100',
};
const brandSlugLower = (b: string) => b.toLowerCase().replace(/[^a-z0-9]/g, '-');
const insertSlugFn = (it: string) => (it === 'plain' ? '' : '-' + it.toLowerCase());
const teikinEntry = teikinCatalog[engine.engine_code];

function productUrl(brand: string, size: string, insertType: string): string | null {
  if (categoryCode !== 'PISTON') return null;
  const sizeSl = SIZE_SLUG[size];
  if (!sizeSl) return null;
  let slug: string;
  if (brand === 'TEIKIN' && teikinEntry?.teikin_pistons?.[0]) {
    const article = teikinEntry.teikin_pistons[0].toLowerCase().replace(/[^a-z0-9]+/g, '-');
    slug = `teikin-${article}${insertSlugFn(insertType)}-${sizeSl}`;
  } else {
    slug = `${brandSlugLower(brand)}${insertSlugFn(insertType)}-${sizeSl}`;
  }
  return `/${brandSlug[engine.brand_name] ?? engine.brand_name.toLowerCase()}/dvigateli/${engineSlug(engine.engine_code)}/porshni/${slug}/`;
}

const attrMap = Object.fromEntries(
  attrs.map((a) => [a.attribute_code, a.value_text ?? a.value_number ?? a.value_integer])
);

// Группируем варианты: бренд → тип вставки → набор доступных размеров (без цен/остатков)
type Variant = {
  brand: string;
  insertType: string;
  sizes: Set<string>;
};
const variantMap = new Map<string, Variant>();
for (const v of variants) {
  const key = `${v.brand_name}|${v.insert_type}`;
  if (!variantMap.has(key)) {
    variantMap.set(key, { brand: v.brand_name, insertType: v.insert_type, sizes: new Set() });
  }
  variantMap.get(key)!.sizes.add(v.size_code);
}
const variantList = [...variantMap.values()].sort(
  (a, b) => a.brand.localeCompare(b.brand) || a.insertType.localeCompare(b.insertType)
);

// Все размеры, которые встречаются у этого двигателя
const allSizes = new Set<string>();
for (const v of variantList) for (const s of v.sizes) allSizes.add(s);
const sizesOrder = ['STD', '0.25', '0.50', '0.75', '1.00'];
const availableSizes = sizesOrder.filter((s) => allSizes.has(s));

// SKUs со стоком — компактная список «В наличии сейчас»
type StockedSku = { brand: string; size: string; insertType: string; url: string };
const stockedSkus: StockedSku[] = [];
for (const v of variantList) {
  for (const s of v.sizes) {
    if (!inStock.has(`${v.brand}|${s}|${v.insertType}`)) continue;
    const url = productUrl(v.brand, s, v.insertType);
    if (url) stockedSkus.push({ brand: v.brand, size: s, insertType: v.insertType, url });
  }
}

// Брендов запчастей под этот двигатель (из БД — то что реально есть)
const partsBrandList = [...new Set(variantList.map((v) => v.brand))];

// Все бренды которые в принципе возим под эту категорию (из конфига parts-brands.ts).
// Это нужно когда в БД ещё не загружена номенклатура для конкретного двигателя,
// но мы хотим показать клиенту какие бренды можем привезти под заказ.
const DB_TO_PART_CATEGORY: Record<string, PartCategory> = {
  PISTON: 'porshni',
  RING: 'koltsa',
};
const currentPartCategory = DB_TO_PART_CATEGORY[categoryCode] ?? 'porshni';
const allBrandsForCategory = brandsForCategory(currentPartCategory);

const oemNumbers = numbers.filter((n) => n.number_type === 'oem' || n.number_type === 'alt_oem');
const tknNumbers = numbers.filter((n) => n.number_type === 'teikin');
const catalogNumbers = numbers.filter((n) => n.number_type.startsWith('catalog_'));

const brandSl = brandSlug[engine.brand_name] ?? engine.brand_name.toLowerCase();
const engSl = engineSlug(engine.engine_code);

// TEIKIN-каталоговое изображение (если есть)
const catalogImgPath = resolve(process.cwd(), `public/teikin-catalog/${engSl}.png`);
const heroImg = existsSync(catalogImgPath) ? `/teikin-catalog/${engSl}.png` : null;

// Список других категорий для этого двигателя (для внутренней перелинковки)
const allPartsIdx = await getEnginePartsIndex();
const otherCategories = allPartsIdx
  .filter((p) => p.engine_code === engine.engine_code && p.category_code !== categoryCode)
  .map((p) => p.category_code);

// SEO: оптимизированные тексты под запросы вида "{категория} {код двигателя}"
const catLower = catLabel.toLowerCase();

// Лонг-форма про мотор для SEO (генерируется из данных)
const longIntroPara = {
  PISTON: `${engine.brand_name} ${engine.engine_code} — ${engine.is_diesel ? 'дизельный' : 'бензиновый'} двигатель${engine.volume_l ? ` объёмом ${fmtNum(engine.volume_l)} литра` : ''}${engine.cylinder_count ? `, ${engine.cylinder_count} цилиндра` : ''}${engine.valve_count ? `, ${engine.valve_count} клапанов` : ''}. При капитальном ремонте этого мотора в первую очередь меняют поршни — это расходная деталь, которая работает на износ. Мы возим оригинальные японские поршни брендов TEIKIN, ND, IZUMI, NM, а также OEM-номера ${engine.brand_name}.`,
  RING: `Поршневые кольца ${engine.brand_name} ${engine.engine_code} — комплект из 3 колец на каждый цилиндр (компрессионное, маслосъёмное, ножевое). При капремонте всегда меняются вместе с поршнями. Возим японские бренды RIK, TP, NPR с гарантией производителя${engine.cylinder_count ? ` (на ${engine.cylinder_count} цилиндров — ${engine.cylinder_count * 3} колец в комплекте)` : ''}.`,
}[categoryCode] ?? '';

const longSecondPara = `Размер ${catLower} определяет моторист после расточки блока цилиндров: если износ небольшой — берут STD (стандартный заводской диаметр), если блок шлифовался — ремонтный размер 0.25, 0.50, 0.75 или 1.00 мм. Точная подборка — по фактическому диаметру цилиндра после расточки. Если не уверены — пришлите в WhatsApp измерения от моториста, подберём комплект.`;
const seoTitle = `${catLabel} ${engine.brand_name} ${engine.engine_code} купить в Алматы — ${partsBrandList[0] || 'TEIKIN'} | MY AVTO`;
const brandNamesForSeo = (partsBrandList.length ? partsBrandList : allBrandsForCategory.map((b) => b.display)).join(', ');
const seoDesc = `${catLabel} на двигатель ${engine.brand_name} ${engine.engine_code}${engine.volume_l ? `, ${fmtNum(engine.volume_l)} л` : ''}. Бренды: ${brandNamesForSeo}. Размеры: ${availableSizes.join(', ') || 'STD, 0.25, 0.50, 0.75'}. Цена и наличие — в WhatsApp.`;
const seoKw = [
  `${catLower} ${engine.engine_code.toLowerCase()}`,
  `${engine.engine_code.toLowerCase()} ${catLower}`,
  `${catLower} ${engine.engine_code.toLowerCase()} алматы`,
  `купить ${catLower} ${engine.engine_code.toLowerCase()}`,
  `${engine.brand_name.toLowerCase()} ${engine.engine_code.toLowerCase()} капремонт`,
  ...(partsBrandList.length ? partsBrandList.map((b) => `${engine.engine_code.toLowerCase()} ${b.toLowerCase()}`) : []),
].join(', ');

// FAQ под эту категорию + двигатель (генерируется автоматически)
const brandListForFaq = partsBrandList.length ? partsBrandList.join(', ') : allBrandsForCategory.map((b) => b.display).join(', ');
const faqItems = [
  {
    q: `Какие ${catLower} подходят на двигатель ${engine.brand_name} ${engine.engine_code}?`,
    a: `На двигатель ${engine.brand_name} ${engine.engine_code} подходят ${catLower} брендов ${brandListForFaq}. ${attrMap.piston_diameter ? `Стандартный диаметр поршня — Ø${fmtNum(attrMap.piston_diameter)} мм. ` : ''}Доступные ремонтные размеры: ${availableSizes.join(', ') || 'STD, 0.25, 0.50, 0.75, 1.00'}.`,
  },
  {
    q: `Какой размер ${catLower} выбрать для ${engine.engine_code}?`,
    a: `Если двигатель ${engine.engine_code} не растачивался — берите STD (стандарт). После расточки блока цилиндров — соответствующий ремонтный размер: 0.25, 0.50, 0.75 или 1.00 мм. Точный размер скажет моторист после замера цилиндров.`,
  },
  {
    q: `Сколько стоят ${catLower} на ${engine.brand_name} ${engine.engine_code}?`,
    a: `Цена зависит от бренда и размера. Напишите код двигателя в WhatsApp +7 701 550 9377 — пришлём актуальную цену и наличие. Работаем напрямую с поставщиками из Японии.`,
  },
  {
    q: `Есть ли ${catLower} в наличии в Алматы?`,
    a: `Самые ходовые позиции в наличии в магазине: Алматы, ТЦ CarCity, 3 ярус, бутик 135В. Редкие размеры — под заказ из Японии, срок 7-14 дней. Точное наличие проверим по коду двигателя в WhatsApp.`,
  },
  {
    q: `Чем отличаются TEIKIN, IZUMI и оригинал?`,
    a: `TEIKIN и IZUMI — японские aftermarket-производители уровня OEM: на их заводах разливают поршни для большинства японских автоконцернов. Качество и ресурс не уступают оригиналу. Оригинальные ${engine.brand_name} — те же поршни в фирменной упаковке, цена выше в 2–3 раза. Для капремонта почти всегда выбирают TEIKIN.`,
  },
  {
    q: `Есть ли гарантия на ${catLower}?`,
    a: `Да, на все запчасти TEIKIN, IZUMI, NPR, RIK, Taiho даём гарантию от производителя. Если деталь окажется бракованной или не подойдёт по размеру — обменяем или вернём деньги. Подробнее на странице «Гарантия и возврат».`,
  },
  {
    q: `Доставка по Казахстану из Алматы — как и сколько?`,
    a: `По Алматы — курьер в день оплаты (300–1500 ₸). По Казахстану — автобус, авиа, Kazpost, InDriver. Срок 1–3 дня, стоимость зависит от города. Оплачивается отдельно по тарифу транспортной компании. Уточним при заказе.`,
  },
  {
    q: `Как заказать ${catLower} на ${engine.engine_code}?`,
    a: `Напишите в WhatsApp +7 701 550 9377 код двигателя (${engine.engine_code}) и нужный размер. Менеджер пришлёт варианты с ценой и наличием в течение 15 минут в рабочее время. Оплата — перевод, наличные при самовывозе или безнал для юр.лиц с НДС.`,
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://my-avto.kz/' },
      { '@type': 'ListItem', position: 2, name: engine.brand_name, item: `https://my-avto.kz/${brandSl}/` },
      { '@type': 'ListItem', position: 3, name: engine.engine_code, item: `https://my-avto.kz/${brandSl}/dvigateli/${engSl}/` },
      { '@type': 'ListItem', position: 4, name: catLabel },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: `${catLabel} ${engine.brand_name} ${engine.engine_code}`,
    description: seoDesc,
    category: catLabel,
    brand: partsBrandList.length ? partsBrandList.map((b) => ({ '@type': 'Brand', name: b })) : [{ '@type': 'Brand', name: 'TEIKIN' }],
    image: 'https://my-avto.kz/assets/og-image.jpg',
    sku: tknNumbers[0]?.number_value || oemNumbers[0]?.number_value || `${engine.engine_code}-${categoryCode}`,
    ...(categoryCode === 'PISTON' ? {
      offers: {
        '@type': 'AggregateOffer',
        priceCurrency: 'KZT',
        lowPrice: '15000',
        availability: 'https://schema.org/InStock',
        seller: { '@type': 'AutoPartsStore', name: 'MY AVTO' },
        url: `https://my-avto.kz/${brandSl}/dvigateli/${engSl}/${categorySlug[categoryCode]}/`,
      },
    } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title={seoTitle}
  description={seoDesc}
  keywords={seoKw}
  jsonLd={jsonLd}
  stickyWaText={`Здравствуйте! Интересует цена и наличие на ${catLower} для ${engine.brand_name} ${engine.engine_code}.`}
>
  <!-- Hero v2 — light, 2-column with TEIKIN catalog image -->
  <div class="container hero-v2">
    <Breadcrumbs items={[
      { name: 'Главная', href: '/' },
      { name: engine.brand_name, href: `/${brandSl}/` },
      { name: engine.engine_code, href: `/${brandSl}/dvigateli/${engSl}/` },
      { name: catLabel },
    ]} />
    <div class="hv2-grid">
      <div class="hv2-img-wrap">
        {heroImg
          ? <img src={heroImg} alt={`Каталог TEIKIN ${engine.engine_code}`} class="hv2-img" loading="eager" />
          : <div class="hv2-img-placeholder">⚙️</div>}
        {stockedSkus.length > 0 && (
          <span class="hv2-stock-pill">● В наличии — {stockedSkus.length} {stockedSkus.length === 1 ? 'позиция' : 'позиций'}</span>
        )}
      </div>
      <div class="hv2-body">
        <div class="hv2-tags">
          <span class="hv2-tag">{engine.brand_name}</span>
          <span class="hv2-tag mono">{engine.engine_code}</span>
          {engine.volume_l && <span class="hv2-tag">{fmtNum(engine.volume_l)} л</span>}
          {engine.is_diesel ? <span class="hv2-tag hv2-tag-diesel">Дизель</span> : <span class="hv2-tag">Бензин</span>}
        </div>
        <h1 class="hv2-h1">
          {catLabel} на двигатель <span class="hv2-engine">{engine.brand_name} {engine.engine_code}</span> в Алматы
        </h1>
        <p class="hv2-lead">
          Купить {catLower} {engine.engine_code} в Алматы с подбором по размеру и бренду.
          Доступные бренды: <strong>{(partsBrandList.length > 0 ? partsBrandList.map(brandDisplay) : allBrandsForCategory.map((b) => b.display)).join(', ')}</strong>.
          Размеры: <strong>{availableSizes.join(', ') || 'STD, 0.25, 0.50, 0.75, 1.00'}</strong>.
        </p>
        <div class="hv2-quick-facts">
          {attrMap.piston_diameter && (
            <div class="hv2-fact"><span class="hv2-fact-l">Диаметр поршня</span><span class="hv2-fact-v">Ø{fmtNum(attrMap.piston_diameter)} мм</span></div>
          )}
          {engine.cylinder_count && (
            <div class="hv2-fact"><span class="hv2-fact-l">Цилиндров</span><span class="hv2-fact-v">{engine.cylinder_count}</span></div>
          )}
          {engine.valve_count && (
            <div class="hv2-fact"><span class="hv2-fact-l">Клапанов</span><span class="hv2-fact-v">{engine.valve_count}</span></div>
          )}
          <div class="hv2-fact"><span class="hv2-fact-l">Топливо</span><span class="hv2-fact-v">{engine.is_diesel ? 'Дизель' : 'Бензин'}</span></div>
        </div>
        {categoryCode === 'PISTON' && (
          <div class="hv2-price">
            <span class="hv2-price-from">Цена за комплект</span>
            <span class="hv2-price-val">от 15 000 ₸</span>
          </div>
        )}
        <div class="hv2-cta-row">
          <a href={`https://wa.me/77015509377?text=${encodeURIComponent(`Здравствуйте! Интересует цена и наличие на ${catLower} для ${engine.brand_name} ${engine.engine_code}.`)}`} target="_blank" rel="noopener noreferrer" class="btn hv2-cta-primary tap-press">Узнать цену в WhatsApp</a>
          <a href="tel:+77015509377" class="hv2-cta-phone tap-press">+7 701 550-93-77</a>
        </div>
      </div>
    </div>
  </div>

  {stockedSkus.length > 0 && (
    <div class="container quick-stock-mobile">
      <div class="list-head">
        <div>
          <h2>{catLabel}</h2>
          <p class="muted small">Найдено {stockedSkus.length} {stockedSkus.length === 1 ? 'товар' : 'товаров'}</p>
        </div>
        <a href={`https://wa.me/77015509377?text=${encodeURIComponent(`Здравствуйте! Покажите все варианты ${catLower} на ${engine.brand_name} ${engine.engine_code}.`)}`} target="_blank" rel="noopener noreferrer">Фильтры</a>
      </div>
      <div class="product-list-grid">
        {stockedSkus.map((it) => (
          <a href={it.url} class="product-list-card tap-press">
            <img src={heroImg ?? '/teikin-photos/piston-sample.png'} alt={`${catLabel} ${engine.engine_code} ${it.size}`} loading="lazy" />
            <span class="product-list-body">
              <span class="sc-brand">{brandDisplay(it.brand)} {engine.engine_code}</span>
              <span class="sc-meta">OEM: {oemNumbers[0]?.number_value ?? tknNumbers[0]?.number_value ?? engine.engine_code}</span>
              <span class="sc-stock"><span></span>В наличии</span>
              <span class="sc-price">от 15 000 ₸</span>
            </span>
            <span class="cart-mini" aria-hidden="true">▾</span>
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- Long-form intro для SEO -->
  <div class="container">
    <section class="reveal long-intro">
      <p>{longIntroPara}</p>
      <p>{longSecondPara}</p>
    </section>
  </div>

  <div class="container">
    <section class="reveal">
      <h2>Технические характеристики двигателя</h2>
      <div class="specs-table">
        <div class="spec-row">
          <div class="spec-row-label">Марка авто</div>
          <div class="spec-row-val">{engine.brand_name}</div>
        </div>
        <div class="spec-row">
          <div class="spec-row-label">Код двигателя</div>
          <div class="spec-row-val mono"><strong>{engine.engine_code}</strong></div>
        </div>
        {engine.volume_l && (
          <div class="spec-row">
            <div class="spec-row-label">Объём двигателя</div>
            <div class="spec-row-val">{fmtNum(engine.volume_l)} л</div>
          </div>
        )}
        {engine.cylinder_count && (
          <div class="spec-row">
            <div class="spec-row-label">Количество цилиндров</div>
            <div class="spec-row-val">{engine.cylinder_count}</div>
          </div>
        )}
        {engine.valve_count && (
          <div class="spec-row">
            <div class="spec-row-label">Клапанов</div>
            <div class="spec-row-val">{engine.valve_count}</div>
          </div>
        )}
        <div class="spec-row">
          <div class="spec-row-label">Тип топлива</div>
          <div class="spec-row-val">{engine.is_diesel ? 'Дизель' : 'Бензин'}</div>
        </div>
        {attrMap.piston_diameter && (
          <div class="spec-row">
            <div class="spec-row-label">Диаметр поршня</div>
            <div class="spec-row-val">Ø {fmtNum(attrMap.piston_diameter)} мм</div>
          </div>
        )}
        {attrMap.pin_diameter && (
          <div class="spec-row">
