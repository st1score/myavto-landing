---
// Product page для конкретного поршня — одна страница на (engine × parts brand × size × insert type).
// URL: /<brand>/dvigateli/<engine>/porshni/<product>/
// Структура максимально компактная — должна влезать в 2-3 экрана мобильного.

import Base from '../../../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import { getEngines, getPistonProductsInStock } from '../../../../../../lib/db';
import { brandSlug, engineSlug } from '../../../../../../lib/slugs';
import { partsBrandLabel } from '../../../../../../lib/labels';
import {
  teikinCatalog,
  FUEL_LABEL,
} from '../../../../../../data/teikin-catalog';
import { fmtNum } from '../../../../../../lib/format';

export async function getStaticPaths() {
  const SIZE_SLUG: Record<string, string> = {
    'STD': 'std', '0.25': '025', '0.50': '050', '0.75': '075', '1.00': '100',
  };
  const brandSlugLower = (b: string) => b.toLowerCase().replace(/[^a-z0-9]/g, '-');
  const insertSlug = (it: string) => it === 'plain' ? '' : '-' + it.toLowerCase();

  const [products, engines] = await Promise.all([
    getPistonProductsInStock(),
    getEngines(),
  ]);
  const engByCode = new Map(engines.map((e) => [e.engine_code, e]));

  const paths = [];
  for (const p of products) {
    const eng = engByCode.get(p.engine_code);
    if (!eng) continue;
    const sizeSl = SIZE_SLUG[p.size_code];
    if (!sizeSl) continue;

    let productSlug;
    const teikinEntry = teikinCatalog[p.engine_code];
    if (p.parts_brand === 'TEIKIN' && teikinEntry?.teikin_pistons?.[0]) {
      const article = teikinEntry.teikin_pistons[0].toLowerCase().replace(/[^a-z0-9]+/g, '-');
      productSlug = `teikin-${article}${insertSlug(p.insert_type)}-${sizeSl}`;
    } else {
      productSlug = `${brandSlugLower(p.parts_brand)}${insertSlug(p.insert_type)}-${sizeSl}`;
    }

    paths.push({
      params: {
        brand: brandSlug[eng.brand_name] ?? eng.brand_name.toLowerCase(),
        engine: engineSlug(eng.engine_code),
        product: productSlug,
      },
      props: {
        engine: eng,
        product: p,
        teikinEntry: teikinEntry ?? null,
        siblings: products.filter((x) =>
          x.engine_code === p.engine_code &&
          !(x.parts_brand === p.parts_brand && x.size_code === p.size_code && x.insert_type === p.insert_type)
        ),
      },
    });
  }
  return paths;
}

const { engine, product, teikinEntry, siblings } = Astro.props;
const brandSl = brandSlug[engine.brand_name] ?? engine.brand_name.toLowerCase();
const engSl = engineSlug(engine.engine_code);
const sizeLabel = product.size_code;
const partsBrandDisplay = partsBrandLabel[product.parts_brand] ?? product.parts_brand;
const mainArticle = product.parts_brand === 'TEIKIN' && teikinEntry?.teikin_pistons?.[0] || '';
const insertDisplay = product.insert_type === 'plain' ? ''
  : product.insert_type === 'AG' ? ' (ALFIN + gallery)'
  : product.insert_type === 'A' ? ' (ALFIN)'
  : product.insert_type === 'G' ? ' (oil cooling gallery)'
  : ` (${product.insert_type})`;

// Фактический диаметр поршня = номинал + ремонтный размер
// STD = 96.0, 0.25 = 96.25, 0.50 = 96.5, 0.75 = 96.75, 1.00 = 97.0
const SIZE_DELTA: Record<string, number> = {
  'STD': 0, '0.25': 0.25, '0.50': 0.50, '0.75': 0.75, '1.00': 1.00,
};
const actualBoreMm = teikinEntry?.bore_mm != null
  ? teikinEntry.bore_mm + (SIZE_DELTA[product.size_code] ?? 0)
  : null;

// Объём в литрах: 2982 → "3.0"
const ccToLiters = (cc: number): string => (Math.round(cc / 100) / 10).toFixed(1);

// Siblings → разные размеры этого же бренда + другие бренды этого размера
const SIZE_ORDER = ['STD', '0.25', '0.50', '0.75', '1.00'];
function sizeIdx(s: string): number { return SIZE_ORDER.indexOf(s); }

// Для дизелей в реальности гонят только STD и 0.50 — отсекаем редкие 0.25/0.75/1.00
const isDiesel = engine.is_diesel === true;
const allowedSizes = new Set(isDiesel ? ['STD', '0.50'] : ['STD', '0.25', '0.50', '0.75', '1.00']);

// Бренды, которые показываем как «другие варианты» — Riken исключаем (мало позиций).
const ALT_BRAND_WHITELIST = new Set(['ND', 'IZUMI', 'NM', 'OEM', 'TEIKIN', 'KA']);

const otherSizesSameBrand = [...siblings]
  .filter((s) => s.parts_brand === product.parts_brand)
  .filter((s) => allowedSizes.has(s.size_code))
  .filter((s) => s.insert_type === product.insert_type) // не путаем юзера insert-вариантами
  .sort((a, b) => sizeIdx(a.size_code) - sizeIdx(b.size_code));

// Другие бренды того же размера — дедуп по parts_brand, без insert-суффиксов
const seenBrands = new Set<string>();
const otherBrandsSameSize = [...siblings]
  .filter((s) => s.parts_brand !== product.parts_brand
              && s.size_code === product.size_code
              && ALT_BRAND_WHITELIST.has(s.parts_brand))
  .filter((s) => {
    if (seenBrands.has(s.parts_brand)) return false;
    seenBrands.add(s.parts_brand);
    return true;
  });

function siblingUrl(s: typeof siblings[number]): string {
  const sizeSl = ({ 'STD': 'std', '0.25': '025', '0.50': '050', '0.75': '075', '1.00': '100' } as Record<string, string>)[s.size_code] ?? 'std';
  const ins = s.insert_type === 'plain' ? '' : '-' + s.insert_type.toLowerCase();
  if (s.parts_brand === 'TEIKIN' && teikinEntry?.teikin_pistons?.[0]) {
    const article = teikinEntry.teikin_pistons[0].toLowerCase().replace(/[^a-z0-9]+/g, '-');
    return `/${brandSl}/dvigateli/${engSl}/porshni/teikin-${article}${ins}-${sizeSl}/`;
  }
  return `/${brandSl}/dvigateli/${engSl}/porshni/${s.parts_brand.toLowerCase().replace(/[^a-z0-9]/g, '-')}${ins}-${sizeSl}/`;
}

// SEO
const titleParts = [`Поршень ${partsBrandDisplay}`, mainArticle, sizeLabel, `на ${engine.brand_name} ${engine.engine_code}`];
const seoTitle = titleParts.filter(Boolean).join(' ') + ' — купить в Алматы | MY AVTO';
const seoDesc = `Поршень ${partsBrandDisplay}${mainArticle ? ' ' + mainArticle : ''} ${sizeLabel}${insertDisplay} на двигатель ${engine.brand_name} ${engine.engine_code}.${teikinEntry?.bore_mm ? ` Ø ${fmtNum(teikinEntry.bore_mm)} мм.` : ''}${teikinEntry?.oem_piston?.[0] ? ' OEM ' + teikinEntry.oem_piston[0] + '.' : ''} Цена и наличие — по WhatsApp. Магазин в Алматы.`;
const seoKw = [
  mainArticle && `TEIKIN ${mainArticle}`, mainArticle, `поршень ${engine.engine_code}`,
  `поршень ${engine.engine_code} ${sizeLabel}`, `${partsBrandDisplay} ${engine.engine_code}`,
  `капремонт ${engine.engine_code}`, ...(teikinEntry?.oem_piston ?? []),
  ...(teikinEntry?.models?.slice(0, 3) ?? []),
].filter(Boolean).join(', ');

const productJsonLd: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: titleParts.filter(Boolean).join(' '),
  description: seoDesc,
  category: 'Поршни двигателя для капремонта',
  brand: { '@type': 'Brand', name: partsBrandDisplay },
  sku: mainArticle || `${product.parts_brand}-${engine.engine_code}-${sizeLabel}`,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'KZT',
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'AutoPartsStore', name: 'MY AVTO', url: 'https://my-avto.kz' },
  },
};
if (teikinEntry?.image) productJsonLd.image = 'https://my-avto.kz' + teikinEntry.image;

const faqItems = [
  {
    q: `Подойдёт ли ${partsBrandDisplay} ${mainArticle || ''} ${sizeLabel} на мой ${engine.engine_code}?`,
    a: `Да, если двигатель ${product.size_code === 'STD' ? 'не растачивался — STD это заводской размер' : `расточен на +${sizeLabel.replace('0.', '')} мм относительно STD`}. ${teikinEntry?.bore_mm ? `Диаметр поршня — Ø${fmtNum(teikinEntry.bore_mm)} мм. ` : ''}Точный размер скажет моторист после замера цилиндров.`,
  },
  {
    q: 'Что входит в комплект?',
    a: `В комплект поршня ${partsBrandDisplay} входит: сам поршень + поршневой палец. Поршневые кольца и гильзы — продаются отдельно.`,
  },
  mainArticle ? {
    q: `Что значит артикул ${mainArticle}?`,
    a: `${mainArticle} — каталожный номер TEIKIN для поршня двигателя ${engine.brand_name} ${engine.engine_code}. Суффиксы по каталогу TEIKIN: «A» — ALFIN reinforcement (никель-чугунное армирование канавки 1-го кольца), «G» — oil cooling gallery (масляная галерея в днище), «AG» — обе технологии вместе.`,
  } : null,
  {
    q: 'Сколько стоит?',
    a: `Актуальная цена и наличие — по WhatsApp. Пришлём в течение 10 минут.`,
  },
].filter(Boolean) as { q: string; a: string }[];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const breadcrumbsJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://my-avto.kz/' },
    { '@type': 'ListItem', position: 2, name: engine.brand_name, item: `https://my-avto.kz/${brandSl}/` },
    { '@type': 'ListItem', position: 3, name: engine.engine_code, item: `https://my-avto.kz/${brandSl}/dvigateli/${engSl}/` },
    { '@type': 'ListItem', position: 4, name: 'Поршни', item: `https://my-avto.kz/${brandSl}/dvigateli/${engSl}/porshni/` },
    { '@type': 'ListItem', position: 5, name: `${partsBrandDisplay} ${mainArticle || sizeLabel}` },
  ],
};

const waText = encodeURIComponent(
  `Здравствуйте! Интересует поршень ${partsBrandDisplay}${mainArticle ? ' ' + mainArticle : ''} ${sizeLabel}${insertDisplay} на двигатель ${engine.brand_name} ${engine.engine_code}. Подскажите цену и наличие.`
);
---
<Base
  title={seoTitle}
  description={seoDesc}
  keywords={seoKw}
  jsonLd={[productJsonLd, breadcrumbsJsonLd, faqJsonLd]}
>
  <div class="container product-page">
    <Breadcrumbs items={[
      { name: 'Главная', href: '/' },
      { name: engine.brand_name, href: `/${brandSl}/` },
      { name: engine.engine_code, href: `/${brandSl}/dvigateli/${engSl}/` },
      { name: 'Поршни', href: `/${brandSl}/dvigateli/${engSl}/porshni/` },
      { name: `${partsBrandDisplay}${mainArticle ? ' ' + mainArticle : ''} ${sizeLabel}` },
    ]} />

    {/*
      Redesign 2026-05: вдохновение nipponfz.com — белый фон, синий акцент, чистая типографика.
      Иерархия:
      1. HERO (выше «склейки»): изображение слева, артикул+спеки+CTA справа — всё важное на 1 экране.
      2. VARIANTS — модификации/размеры/бренды-аналоги в одной компактной решётке.
      3. BRANDS — лого Teikin/Izumi/ND/NM, чтобы покупатель узнавал коробку.
      4. DETAILS — раскрывающиеся блоки: реальные фото, OEM, авто, FAQ. Не грузят первый экран.
      5. FINAL CTA.
    */}

    <!-- HERO -->
    <section class="ph-hero reveal">
      <div class="ph-hero-visual">
        {teikinEntry?.image ? (
          <figure class="ph-img">
            <img src={teikinEntry.image} alt={`Поршень ${partsBrandDisplay} ${mainArticle} ${sizeLabel} — ${engine.brand_name} ${engine.engine_code}`} loading="eager" />
            <figcaption>Страница из e-catalog TEIKIN</figcaption>
          </figure>
        ) : (
          <figure class="ph-img ph-img-fallback">
            <img src="/teikin-photos/piston-sample.png" alt={`Поршень ${partsBrandDisplay}`} loading="eager" />
          </figure>
        )}
      </div>

      <div class="ph-hero-info">
        <div class="ph-meta">
          <span class="ph-brand-pill">{partsBrandDisplay}</span>
          <span class="ph-stock"><span class="dot"></span>в наличии</span>
        </div>

        <h1 class="ph-title">
          Поршень{mainArticle ? <> <span class="ph-article mono">№ {mainArticle}</span></> : null}
        </h1>
        <p class="ph-sub">{sizeLabel}{product.insert_type !== 'plain' && <> · {product.insert_type}</>} · {engine.brand_name} {engine.engine_code}</p>

        <dl class="ph-facts">
          {actualBoreMm != null && (
            <div class="ph-fact ph-fact-key">
              <dt>Диаметр поршня</dt>
              <dd>Ø {fmtNum(actualBoreMm)}<span class="unit">мм</span></dd>
            </div>
          )}
          <div class="ph-fact ph-fact-key">
            <dt>Ремонтный размер</dt>
            <dd>{sizeLabel}{product.size_code !== 'STD' && <span class="unit">+{sizeLabel.replace('0.', '')} мм</span>}</dd>
          </div>
          {teikinEntry?.cc && (
            <div class="ph-fact">
              <dt>Двигатель</dt>
              <dd>{ccToLiters(teikinEntry.cc)} л · {teikinEntry.cyl} цил.</dd>
            </div>
          )}
          {teikinEntry?.fuel && (
            <div class="ph-fact">
              <dt>Топливо</dt>
              <dd>{FUEL_LABEL[teikinEntry.fuel]}</dd>
            </div>
          )}
        </dl>

        <div class="ph-cta">
          <a href={`https://wa.me/77015509377?text=${waText}`} class="ph-btn ph-btn-primary" target="_blank" rel="noopener noreferrer">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zm-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884z"/></svg>
            Узнать цену в WhatsApp
          </a>
          <a href="tel:+77015509377" class="ph-btn ph-btn-secondary">+7 701 550-93-77</a>
        </div>

        <div class="ph-kit">
          В комплекте: <b>поршень + палец</b>. Кольца и гильзы — <a href={`/${brandSl}/dvigateli/${engSl}/`}>отдельно</a>.
        </div>
      </div>
    </section>

    <!-- VARIANTS -->
    {(teikinEntry?.teikin_pistons?.length || otherSizesSameBrand.length > 0 || otherBrandsSameSize.length > 0) && (
      <section class="ph-section reveal">
        <h2 class="ph-h2">Варианты этого артикула</h2>
        <div class="ph-var-grid">
          {teikinEntry?.teikin_pistons && teikinEntry.teikin_pistons.length > 0 && (
            <div class="ph-var-col ph-var-col-wide">
              <div class="ph-var-h">Модификации поршня</div>
              <ul class="ph-var-articles">
                {teikinEntry.teikin_pistons.map((art) => {
                  const isCurrent = mainArticle === art;
                  const variant = art.replace(teikinEntry.teikin_pistons[0]!, '') || '';
                  const label = variant === '' ? 'базовый'
                    : variant === 'A' ? 'ALFIN reinforcement'
                    : variant === 'G' ? 'oil cooling gallery'
                    : variant === 'AG' ? 'ALFIN + gallery'
                    : variant;
                  return (
                    <li class={isCurrent ? 'is-current' : ''}>
                      <span class="ph-art-num mono">{art}</span>
                      <span class="ph-art-label">{label}</span>
                    </li>
                  );
                })}
              </ul>
              <details class="ph-var-expand">
                <summary>Что значат суффиксы A, G и AG?</summary>
                <div class="ph-var-explain">
                  <div><b class="tag-a">A</b> — ALFIN reinforcement. Никель-чугунная вставка вокруг канавки 1-го кольца, защищает от выгорания на дизелях.</div>
                  <div><b class="tag-g">G</b> — oil cooling gallery. Масляный канал внутри короны, снимает температуру у турбо.</div>
                  <div><b class="tag-ag">AG</b> — обе технологии вместе. Максимальная версия для тяжёлых турбодизелей.</div>
                </div>
              </details>
            </div>
          )}

          {otherSizesSameBrand.length > 0 && (
            <div class="ph-var-col">
              <div class="ph-var-h">Размеры {partsBrandDisplay}</div>
              <div class="ph-var-chips">
                <span class="ph-chip ph-chip-cur">{sizeLabel}</span>
                {otherSizesSameBrand.map((s) => (
                  <a href={siblingUrl(s)} class="ph-chip">{s.size_code}</a>
                ))}
              </div>
            </div>
          )}

          {otherBrandsSameSize.length > 0 && (
            <div class="ph-var-col">
              <div class="ph-var-h">Тот же артикул в других брендах</div>
              <div class="ph-var-chips">
                <span class="ph-chip ph-chip-cur">{partsBrandDisplay}</span>
                {otherBrandsSameSize.map((s) => (
                  <a href={siblingUrl(s)} class="ph-chip">{partsBrandLabel[s.parts_brand] ?? s.parts_brand}</a>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- BRANDS strip -->
    <section class="ph-section ph-brands reveal">
      <h2 class="ph-h2">Бренды поршней на складе</h2>
      <div class="ph-brands-grid">
        <div class="ph-brand-card"><img src="/assets/parts-brands/teikin.png" alt="Teikin" loading="lazy" /><div><b>Teikin</b><small>Япония</small></div></div>
        <div class="ph-brand-card"><img src="/assets/parts-brands/izumi.png" alt="Izumi" loading="lazy" /><div><b>Izumi</b><small>Япония</small></div></div>
        <div class="ph-brand-card"><img src="/assets/parts-brands/nd.png" alt="ND Components" loading="lazy" /><div><b>ND</b><small>оригинал</small></div></div>
        <div class="ph-brand-card"><img src="/assets/parts-brands/nm.png" alt="NM" loading="lazy" /><div><b>NM</b><small>Тайвань</small></div></div>
      </div>
    </section>

    <!-- DETAILS — раскрывающиеся вспомогательные блоки -->
    <section class="ph-section ph-details-section reveal">
      {product.parts_brand === 'TEIKIN' && (
        <details class="ph-det">
          <summary>Реальные фото товара и упаковка</summary>
          <div class="ph-det-body">
            <div class="ph-real-photos">
              <figure>
                <img src="/teikin-photos/piston-sample.png" alt="Реальный поршень TEIKIN" loading="lazy" />
                <figcaption>Поршень TEIKIN</figcaption>
              </figure>
              <figure>
                <img src="/teikin-photos/boxes.png" alt="Фирменные упаковки TEIKIN" loading="lazy" />
                <figcaption>Фирменная упаковка</figcaption>
              </figure>
            </div>
          </div>
        </details>
      )}

      {teikinEntry?.oem_piston?.length ? (
        <details class="ph-det">
          <summary>OEM номера производителя двигателя</summary>
          <div class="ph-det-body">
            <div class="ph-oem-list">
              {teikinEntry.oem_piston.map((o) => <code>{o}</code>)}
            </div>
            <p class="ph-det-note">Номера из официального каталога производителя автомобиля — пригодятся для сверки на СТО.</p>
          </div>
        </details>
      ) : null}

      {teikinEntry?.models && teikinEntry.models.length > 0 && (
        <details class="ph-det">
          <summary>На какие авто подходит ({teikinEntry.models.length})</summary>
          <div class="ph-det-body">
            <ul class="ph-models">{teikinEntry.models.map((m) => <li>{m}</li>)}</ul>
          </div>
        </details>
      )}

      {faqItems.map((f, i) => (
        <details class="ph-det" open={i === 0}>
          <summary>{f.q}</summary>
          <div class="ph-det-body">
            <p>{f.a}</p>
          </div>
        </details>
      ))}
    </section>

    <!-- FINAL CTA -->
    <section class="ph-final reveal">
      <div class="ph-final-text">
        <div class="ph-final-h">Готовы заказать?</div>
        <div class="ph-final-sub">Цена и наличие — в WhatsApp в течение 10 минут.</div>
      </div>
      <a href={`https://wa.me/77015509377?text=${waText}`} class="ph-btn ph-btn-primary ph-btn-big" target="_blank" rel="noopener noreferrer">
        Узнать цену →
      </a>
      <div class="ph-final-meta">ТЦ CarCity · 3 ярус, бутик 135В · Доставка по Казахстану</div>
    </section>
  </div>
</Base>

<style>
