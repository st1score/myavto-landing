---
// Product page для конкретного поршня — одна страница на (engine × parts brand × size × insert type).
// URL: /<brand>/dvigateli/<engine>/porshni/<product>/
// Структура максимально компактная — должна влезать в 2-3 экрана мобильного.

import Base from '../../../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import { getEngines, getPistonProductsInStock } from '../../../../../../lib/db';
import { brandSlug, engineSlug } from '../../../../../../lib/slugs';
import { partsBrandLabel } from '../../../../../../lib/labels';
import {
  teikinCatalog,
  FUEL_LABEL,
} from '../../../../../../data/teikin-catalog';
import { fmtNum } from '../../../../../../lib/format';

export async function getStaticPaths() {
  const SIZE_SLUG: Record<string, string> = {
    'STD': 'std', '0.25': '025', '0.50': '050', '0.75': '075', '1.00': '100',
  };
  const brandSlugLower = (b: string) => b.toLowerCase().replace(/[^a-z0-9]/g, '-');
  const insertSlug = (it: string) => it === 'plain' ? '' : '-' + it.toLowerCase();

  const [products, engines] = await Promise.all([
    getPistonProductsInStock(),
    getEngines(),
  ]);
  const engByCode = new Map(engines.map((e) => [e.engine_code, e]));

  const paths = [];
  for (const p of products) {
    const eng = engByCode.get(p.engine_code);
    if (!eng) continue;
    const sizeSl = SIZE_SLUG[p.size_code];
    if (!sizeSl) continue;

    let productSlug;
    const teikinEntry = teikinCatalog[p.engine_code];
    if (p.parts_brand === 'TEIKIN' && teikinEntry?.teikin_pistons?.[0]) {
      const article = teikinEntry.teikin_pistons[0].toLowerCase().replace(/[^a-z0-9]+/g, '-');
      productSlug = `teikin-${article}${insertSlug(p.insert_type)}-${sizeSl}`;
    } else {
      productSlug = `${brandSlugLower(p.parts_brand)}${insertSlug(p.insert_type)}-${sizeSl}`;
    }

    paths.push({
      params: {
        brand: brandSlug[eng.brand_name] ?? eng.brand_name.toLowerCase(),
        engine: engineSlug(eng.engine_code),
        product: productSlug,
      },
      props: {
        engine: eng,
        product: p,
        teikinEntry: teikinEntry ?? null,
        siblings: products.filter((x) =>
          x.engine_code === p.engine_code &&
          !(x.parts_brand === p.parts_brand && x.size_code === p.size_code && x.insert_type === p.insert_type)
        ),
      },
    });
  }
  return paths;
}

const { engine, product, teikinEntry, siblings } = Astro.props;
const brandSl = brandSlug[engine.brand_name] ?? engine.brand_name.toLowerCase();
const engSl = engineSlug(engine.engine_code);
const sizeLabel = product.size_code;
const partsBrandDisplay = partsBrandLabel[product.parts_brand] ?? product.parts_brand;
const mainArticle = product.parts_brand === 'TEIKIN' && teikinEntry?.teikin_pistons?.[0] || '';
const insertDisplay = product.insert_type === 'plain' ? ''
  : product.insert_type === 'AG' ? ' (ALFIN + gallery)'
  : product.insert_type === 'A' ? ' (ALFIN)'
  : product.insert_type === 'G' ? ' (oil cooling gallery)'
  : ` (${product.insert_type})`;

// Фактический диаметр поршня = номинал + ремонтный размер
// STD = 96.0, 0.25 = 96.25, 0.50 = 96.5, 0.75 = 96.75, 1.00 = 97.0
const SIZE_DELTA: Record<string, number> = {
  'STD': 0, '0.25': 0.25, '0.50': 0.50, '0.75': 0.75, '1.00': 1.00,
};
const actualBoreMm = teikinEntry?.bore_mm != null
  ? teikinEntry.bore_mm + (SIZE_DELTA[product.size_code] ?? 0)
  : null;

// Объём в литрах: 2982 → "3.0"
const ccToLiters = (cc: number): string => (Math.round(cc / 100) / 10).toFixed(1);

// Siblings → разные размеры этого же бренда + другие бренды этого размера
const SIZE_ORDER = ['STD', '0.25', '0.50', '0.75', '1.00'];
function sizeIdx(s: string): number { return SIZE_ORDER.indexOf(s); }

// Для дизелей в реальности гонят только STD и 0.50 — отсекаем редкие 0.25/0.75/1.00
const isDiesel = engine.is_diesel === true;
const allowedSizes = new Set(isDiesel ? ['STD', '0.50'] : ['STD', '0.25', '0.50', '0.75', '1.00']);

// Бренды, которые показываем как «другие варианты» — Riken исключаем (мало позиций).
const ALT_BRAND_WHITELIST = new Set(['ND', 'IZUMI', 'NM', 'OEM', 'TEIKIN', 'KA']);

const otherSizesSameBrand = [...siblings]
  .filter((s) => s.parts_brand === product.parts_brand)
  .filter((s) => allowedSizes.has(s.size_code))
  .filter((s) => s.insert_type === product.insert_type) // не путаем юзера insert-вариантами
  .sort((a, b) => sizeIdx(a.size_code) - sizeIdx(b.size_code));

// Другие бренды того же размера — дедуп по parts_brand, без insert-суффиксов
const seenBrands = new Set<string>();
const otherBrandsSameSize = [...siblings]
  .filter((s) => s.parts_brand !== product.parts_brand
              && s.size_code === product.size_code
              && ALT_BRAND_WHITELIST.has(s.parts_brand))
  .filter((s) => {
    if (seenBrands.has(s.parts_brand)) return false;
    seenBrands.add(s.parts_brand);
    return true;
  });

function siblingUrl(s: typeof siblings[number]): string {
  const sizeSl = ({ 'STD': 'std', '0.25': '025', '0.50': '050', '0.75': '075', '1.00': '100' } as Record<string, string>)[s.size_code] ?? 'std';
  const ins = s.insert_type === 'plain' ? '' : '-' + s.insert_type.toLowerCase();
  if (s.parts_brand === 'TEIKIN' && teikinEntry?.teikin_pistons?.[0]) {
    const article = teikinEntry.teikin_pistons[0].toLowerCase().replace(/[^a-z0-9]+/g, '-');
    return `/${brandSl}/dvigateli/${engSl}/porshni/teikin-${article}${ins}-${sizeSl}/`;
  }
  return `/${brandSl}/dvigateli/${engSl}/porshni/${s.parts_brand.toLowerCase().replace(/[^a-z0-9]/g, '-')}${ins}-${sizeSl}/`;
}

// SEO
const titleParts = [`Поршень ${partsBrandDisplay}`, mainArticle, sizeLabel, `на ${engine.brand_name} ${engine.engine_code}`];
const seoTitle = titleParts.filter(Boolean).join(' ') + ' — купить в Алматы | MY AVTO';
const seoDesc = `Поршень ${partsBrandDisplay}${mainArticle ? ' ' + mainArticle : ''} ${sizeLabel}${insertDisplay} на двигатель ${engine.brand_name} ${engine.engine_code}.${teikinEntry?.bore_mm ? ` Ø ${fmtNum(teikinEntry.bore_mm)} мм.` : ''}${teikinEntry?.oem_piston?.[0] ? ' OEM ' + teikinEntry.oem_piston[0] + '.' : ''} Цена и наличие — по WhatsApp. Магазин в Алматы.`;
const seoKw = [
  mainArticle && `TEIKIN ${mainArticle}`, mainArticle, `поршень ${engine.engine_code}`,
  `поршень ${engine.engine_code} ${sizeLabel}`, `${partsBrandDisplay} ${engine.engine_code}`,
  `капремонт ${engine.engine_code}`, ...(teikinEntry?.oem_piston ?? []),
  ...(teikinEntry?.models?.slice(0, 3) ?? []),
].filter(Boolean).join(', ');

const productJsonLd: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: titleParts.filter(Boolean).join(' '),
  description: seoDesc,
  category: 'Поршни двигателя для капремонта',
  brand: { '@type': 'Brand', name: partsBrandDisplay },
  sku: mainArticle || `${product.parts_brand}-${engine.engine_code}-${sizeLabel}`,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'KZT',
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'AutoPartsStore', name: 'MY AVTO', url: 'https://my-avto.kz' },
  },
};
if (teikinEntry?.image) productJsonLd.image = 'https://my-avto.kz' + teikinEntry.image;

const faqItems = [
  {
    q: `Подойдёт ли ${partsBrandDisplay} ${mainArticle || ''} ${sizeLabel} на мой ${engine.engine_code}?`,
    a: `Да, если двигатель ${product.size_code === 'STD' ? 'не растачивался — STD это заводской размер' : `расточен на +${sizeLabel.replace('0.', '')} мм относительно STD`}. ${teikinEntry?.bore_mm ? `Диаметр поршня — Ø${fmtNum(teikinEntry.bore_mm)} мм. ` : ''}Точный размер скажет моторист после замера цилиндров.`,
  },
  {
    q: 'Что входит в комплект?',
    a: `В комплект поршня ${partsBrandDisplay} входит: сам поршень + поршневой палец. Поршневые кольца и гильзы — продаются отдельно.`,
  },
  mainArticle ? {
    q: `Что значит артикул ${mainArticle}?`,
    a: `${mainArticle} — каталожный номер TEIKIN для поршня двигателя ${engine.brand_name} ${engine.engine_code}. Суффиксы по каталогу TEIKIN: «A» — ALFIN reinforcement (никель-чугунное армирование канавки 1-го кольца), «G» — oil cooling gallery (масляная галерея в днище), «AG» — обе технологии вместе.`,
  } : null,
  {
    q: 'Сколько стоит?',
    a: `Актуальная цена и наличие — по WhatsApp. Пришлём в течение 10 минут.`,
  },
].filter(Boolean) as { q: string; a: string }[];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const breadcrumbsJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://my-avto.kz/' },
    { '@type': 'ListItem', position: 2, name: engine.brand_name, item: `https://my-avto.kz/${brandSl}/` },
    { '@type': 'ListItem', position: 3, name: engine.engine_code, item: `https://my-avto.kz/${brandSl}/dvigateli/${engSl}/` },
    { '@type': 'ListItem', position: 4, name: 'Поршни', item: `https://my-avto.kz/${brandSl}/dvigateli/${engSl}/porshni/` },
    { '@type': 'ListItem', position: 5, name: `${partsBrandDisplay} ${mainArticle || sizeLabel}` },
  ],
};

const waText = encodeURIComponent(
  `Здравствуйте! Интересует поршень ${partsBrandDisplay}${mainArticle ? ' ' + mainArticle : ''} ${sizeLabel}${insertDisplay} на двигатель ${engine.brand_name} ${engine.engine_code}. Подскажите цену и наличие.`
);
---
<Base
  title={seoTitle}
  description={seoDesc}
  keywords={seoKw}
  jsonLd={[productJsonLd, breadcrumbsJsonLd, faqJsonLd]}
>
  <div class="container product-page">
    <Breadcrumbs items={[
      { name: 'Главная', href: '/' },
      { name: engine.brand_name, href: `/${brandSl}/` },
      { name: engine.engine_code, href: `/${brandSl}/dvigateli/${engSl}/` },
      { name: 'Поршни', href: `/${brandSl}/dvigateli/${engSl}/porshni/` },
      { name: `${partsBrandDisplay}${mainArticle ? ' ' + mainArticle : ''} ${sizeLabel}` },
    ]} />

    <!-- HERO — компактный -->
    <header class="ph-head reveal">
      <div class="ph-chips">
        <span class="chip chip-brand">{partsBrandDisplay}</span>
        {mainArticle && <span class="chip chip-article">№ {mainArticle}</span>}
        <span class="chip">{engine.brand_name} {engine.engine_code}</span>
        <span class="chip chip-size">{sizeLabel}</span>
        {product.insert_type !== 'plain' && <span class="chip chip-insert">{product.insert_type}</span>}
      </div>

      <h1>
        Поршень {partsBrandDisplay}{mainArticle && <> № {mainArticle}</>}
        <span class="h1-sub">{sizeLabel}{insertDisplay} — {engine.brand_name} {engine.engine_code}</span>
      </h1>

      <p class="ph-lead">
        Поршень {partsBrandDisplay}{mainArticle && <> арт. <b>{mainArticle}</b></>} для двигателя <b>{engine.brand_name} {engine.engine_code}</b>{teikinEntry?.bore_mm && <>, Ø <b>{fmtNum(teikinEntry.bore_mm)} мм</b></>}{teikinEntry?.cc && <>, {fmtNum(teikinEntry.cc / 1000)} л</>}{teikinEntry?.fuel && <>, {FUEL_LABEL[teikinEntry.fuel]}</>}. <span class="muted">Цена — по WhatsApp.</span>
      </p>

      <div class="cta-row">
        <a href={`https://wa.me/77015509377?text=${waText}`} class="btn btn-wa" target="_blank" rel="noopener noreferrer">
          Цена в WhatsApp →
        </a>
        <a href="tel:+77015509377" class="btn btn-phone">+7 701 550-93-77</a>
      </div>
    </header>

    <!-- РЕАЛЬНЫЕ ФОТО + КАТАЛОЖНАЯ СТРАНИЦА -->
    {product.parts_brand === 'TEIKIN' && (
      <section class="photos-strip reveal">
        <h2 class="photos-h2">Как выглядит товар</h2>
        <div class="photos-grid">
          <figure class="photo-card">
            <img src="/teikin-photos/piston-sample.png" alt={`Реальный поршень TEIKIN — пример внешнего вида`} loading="lazy" />
            <figcaption>Поршень TEIKIN</figcaption>
          </figure>
          <figure class="photo-card">
            <img src="/teikin-photos/boxes.png" alt="Фирменные упаковки TEIKIN" loading="lazy" />
            <figcaption>Фирменная упаковка</figcaption>
          </figure>
        </div>
      </section>
    )}

    <!-- ОСНОВНОЙ БЛОК: картинка из каталога + спеки рядом на десктопе -->
    <div class="main-grid reveal">
      {teikinEntry?.image && (
        <figure class="catalog-fig">
          <img src={teikinEntry.image} alt={`Поршень ${partsBrandDisplay} ${mainArticle} ${sizeLabel} на ${engine.brand_name} ${engine.engine_code}`} loading="lazy" />
        </figure>
      )}

      <div class="specs-card">
        <div class="specs-title">Характеристики</div>
        <dl class="specs-tight">
          <div class="row"><dt>Двигатель</dt><dd>{engine.brand_name} {engine.engine_code}{teikinEntry?.display_name && teikinEntry.display_name !== `${engine.brand_name} ${engine.engine_code}` && <> ({teikinEntry.display_name})</>}</dd></div>
          {teikinEntry?.cc && (
            <div class="row"><dt>Объём</dt><dd>{ccToLiters(teikinEntry.cc)} л · {teikinEntry.cyl} цил.{teikinEntry.fuel && <> · {FUEL_LABEL[teikinEntry.fuel]}</>}</dd></div>
          )}
          <div class="row hl"><dt>Размер</dt><dd><b>{sizeLabel}</b>{product.size_code !== 'STD' && <> <span class="muted small">(+{sizeLabel.replace('0.', '')} мм)</span></>}{product.insert_type !== 'plain' && <> · {product.insert_type}</>}</dd></div>
          {actualBoreMm != null && (
            <div class="row hl"><dt>Диаметр поршня</dt><dd><b>Ø {fmtNum(actualBoreMm)} мм</b>{product.size_code !== 'STD' && teikinEntry?.bore_mm && <> <span class="muted small">(STD: {fmtNum(teikinEntry.bore_mm)})</span></>}</dd></div>
          )}
          {/* Размер пальца не выводим — этой информации не требует покупатель */}
        </dl>

        {teikinEntry?.teikin_pistons && teikinEntry.teikin_pistons.length > 0 && (
          <div class="articles-block">
            <div class="articles-title">Артикулы TEIKIN</div>
            <ul class="articles-list">
              {teikinEntry.teikin_pistons.map((art) => {
                const isCurrent = mainArticle === art;
                const variant = art.replace(teikinEntry.teikin_pistons[0]!, '') || '';
                const label = variant === '' ? 'базовый'
                  : variant === 'A' ? 'ALFIN reinforcement'
                  : variant === 'G' ? 'oil cooling gallery'
                  : variant === 'AG' ? 'ALFIN + gallery'
                  : variant;
                return (
                  <li class={isCurrent ? 'art-current' : ''}>
                    <span class="art-num mono">{art}</span>
                    <span class="art-label">{label}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        )}

        <div class="kit-note">
          <span class="kit-ico">📦</span>
          <span>В комплект входят: <b>поршень + палец</b>. Кольца и гильзы — <a href={`/${brandSl}/dvigateli/${engSl}/`}>отдельно</a>.</span>
        </div>
      </div>
    </div>

    <!-- ОБЪЯСНЕНИЕ типов вставок (A, AG, plain) -->
    <section class="reveal inserts-explain">
      <h2>Чем отличаются модификации поршня</h2>
      <div class="inserts-table">
        <div class="ins-row">
          <div class="ins-tag ins-tag-plain">plain</div>
          <div class="ins-name">Базовый поршень</div>
          <div class="ins-desc">Без армирования канавки 1-го кольца и без масляной галереи. По терминологии TEIKIN — суффикса нет.</div>
        </div>
        <div class="ins-row">
          <div class="ins-tag ins-tag-a">A</div>
          <div class="ins-name">ALFIN reinforcement</div>
          <div class="ins-desc">Никель-чугунная вставка, металлургически связанная с алюминиевой короной в зоне канавки 1-го компрессионного кольца. Защищает канавку от выгорания и разбивания на дизелях.</div>
        </div>
        <div class="ins-row">
          <div class="ins-tag ins-tag-g">G</div>
          <div class="ins-name">Oil cooling gallery</div>
          <div class="ins-desc">Закольцованный масляный канал внутри головки поршня — подаётся масло через форсунку снизу, снимает температуру с короны. Турбодизели и форсированные ДВС.</div>
        </div>
        <div class="ins-row">
          <div class="ins-tag ins-tag-ag">AG</div>
          <div class="ins-name">ALFIN + Gallery</div>
          <div class="ins-desc">И армирование канавки методом ALFIN, и масляная галерея охлаждения. Максимальная версия — для тяжёлых турбо и коммерческих дизелей.</div>
        </div>
      </div>
      <p class="muted small inserts-note">Текущий поршень — <b>{product.insert_type === 'plain' ? 'базовый' : product.insert_type}</b>{mainArticle && <> (артикул {mainArticle})</>}. Если нужна другая модификация — посмотри в блоке «Другие варианты» ниже или напиши в WhatsApp.</p>
    </section>

    <!-- OEM + АНАЛОГИ в одной полоске -->
    <div class="info-row reveal">
      {teikinEntry?.oem_piston?.length || teikinEntry?.oem_pin?.length ? (
        <section class="info-col">
          <h2>OEM номера</h2>
          {teikinEntry.oem_piston?.length ? (
            <div class="oem-line"><span class="oem-label">Поршень</span><div class="oem-vals">{teikinEntry.oem_piston.map((o) => <code>{o}</code>)}</div></div>
          ) : null}
          {/* OEM пальца не показываем — пользователь ищет поршень */}
        </section>
      ) : null}

      {(otherSizesSameBrand.length > 0 || otherBrandsSameSize.length > 0) && (
        <section class="info-col">
          <h2>Другие варианты</h2>
          {otherSizesSameBrand.length > 0 && (
            <div class="alt-line">
              <span class="alt-label">Размеры {partsBrandDisplay}:</span>
              <div class="alt-chips">
                {otherSizesSameBrand.map((s) => (
                  <a href={siblingUrl(s)} class="alt-chip">{s.size_code}</a>
                ))}
              </div>
            </div>
          )}
          {otherBrandsSameSize.length > 0 && (
            <div class="alt-line">
              <span class="alt-label">Тот же артикул в других брендах:</span>
              <div class="alt-chips">
                {otherBrandsSameSize.map((s) => (
                  <a href={siblingUrl(s)} class="alt-chip">{partsBrandLabel[s.parts_brand] ?? s.parts_brand}</a>
                ))}
              </div>
            </div>
          )}
        </section>
      )}
    </div>

    <!-- ЛОГО производителей поршней — чтобы было понятно как они выглядят -->
    <section class="reveal brand-logos">
      <h2>Бренды поршней, которые мы возим</h2>
      <div class="bl-grid">
        <div class="bl-card"><img src="/assets/parts-brands/teikin.png" alt="Teikin (Япония) — производитель поршней" loading="lazy" /><span>Teikin <small>Япония</small></span></div>
        <div class="bl-card"><img src="/assets/parts-brands/izumi.png" alt="Izumi (Япония) — производитель поршней" loading="lazy" /><span>Izumi <small>Япония</small></span></div>
        <div class="bl-card"><img src="/assets/parts-brands/nd.png" alt="ND Components — производитель поршней" loading="lazy" /><span>ND <small>оригинал</small></span></div>
        <div class="bl-card"><img src="/assets/parts-brands/nm.png" alt="NM (Тайвань) — производитель поршней" loading="lazy" /><span>NM <small>Тайвань</small></span></div>
      </div>
    </section>

    <!-- Совместимые модели + FAQ -->
    {teikinEntry?.models && teikinEntry.models.length > 0 && (
      <section class="reveal models">
        <h2>На какие авто</h2>
        <ul>{teikinEntry.models.map((m) => <li>{m}</li>)}</ul>
      </section>
    )}

    <section class="reveal faq">
      <h2>Вопросы</h2>
      <div class="faq-list">
        {faqItems.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- Финальная CTA -->
    <section class="cta-final reveal">
      <a href={`https://wa.me/77015509377?text=${waText}`} class="btn btn-wa btn-big" target="_blank" rel="noopener noreferrer">
        Узнать цену и оформить →
      </a>
      <div class="cta-meta">ТЦ CarCity, 3 ярус, бутик 135В · Доставка по Казахстану</div>
    </section>
  </div>
</Base>

<style>
  .product-page { padding-bottom: 32px; max-width: 1100px; }

  /* HERO */
  .ph-head { padding: 16px 0 12px; }
  .ph-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .chip {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--c-bg-soft);
    border: 1px solid var(--c-border);
    font-size: .78rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .chip-brand { background: #0f172a; color: #fff; border-color: #0f172a; }
  .chip-article { background: var(--c-red); color: #fff; border-color: var(--c-red); font-family: 'JetBrains Mono', monospace; }
  .chip-size { background: #fef3c7; color: #92400e; border-color: #fbbf24; }
  .chip-insert { background: #ede9fe; color: #5b21b6; border-color: #c4b5fd; }

  h1 { font-size: clamp(1.35rem, 3vw, 1.9rem); margin: 0 0 6px; line-height: 1.2; }
  .h1-sub { display: block; font-size: 0.6em; font-weight: 600; color: var(--c-text-dim); margin-top: 4px; }

  .ph-lead { font-size: .98rem; color: var(--c-text-dim); margin: 6px 0 14px; line-height: 1.5; }
  .ph-lead b { color: var(--c-text); }

  .cta-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .btn-wa {
    background: var(--c-red);
    color: #fff !important;
    padding: 12px 22px;
    border-radius: 12px;
    font-weight: 700;
    text-decoration: none;
    border: none;
    display: inline-flex;
    align-items: center;
    transition: transform var(--t-fast), box-shadow var(--t-fast);
  }
  .btn-wa:hover { transform: translateY(-1px); box-shadow: 0 4px 16px rgba(229,9,20,0.3); }
  .btn-phone {
    background: #fff;
    color: var(--c-text) !important;
    border: 1.5px solid var(--c-border);
    padding: 12px 22px;
    border-radius: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: border-color var(--t-fast);
    display: inline-flex; align-items: center;
  }
  .btn-phone:hover { border-color: var(--c-red); color: var(--c-red) !important; }
  .btn-big { padding: 16px 28px; font-size: 1.05rem; }

  /* Photos strip — real piston + boxes */
  .photos-strip {
    margin-bottom: 18px;
    padding: 18px;
    background: linear-gradient(135deg, #fff7ed 0%, #fef3c7 50%, #fef9c3 100%);
    border: 1px solid #fcd34d;
    border-radius: 14px;
  }
  .photos-h2 {
    font-size: .82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #92400e;
    margin: 0 0 12px;
  }
  .photos-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .photo-card {
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: 10px;
    overflow: hidden;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .photo-card img {
    width: 100%;
    height: 180px;
    object-fit: contain;
    background: #fff;
    padding: 12px;
    box-sizing: border-box;
  }
  .photo-card figcaption {
    padding: 8px 12px;
    background: var(--c-bg-soft);
    border-top: 1px solid var(--c-border);
    font-size: .82rem;
    text-align: center;
    color: var(--c-text-dim);
    font-weight: 600;
  }
  @media (max-width: 480px) {
    .photo-card img { height: 140px; padding: 8px; }
  }

  /* MAIN GRID */
  .main-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 18px;
    margin-bottom: 22px;
  }
  @media (max-width: 720px) {
    .main-grid { grid-template-columns: 1fr; gap: 14px; }
  }

  .catalog-fig {
    margin: 0;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: 14px;
    overflow: hidden;
  }
  .catalog-fig img { width: 100%; height: auto; display: block; }

  /* Specs card */
  .specs-card {
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: 14px;
    padding: 18px 18px 14px;
  }
  .specs-title {
    font-size: .78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-faint);
    margin-bottom: 10px;
  }
  .specs-tight { display: flex; flex-direction: column; }
  .specs-tight .row {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 10px;
    padding: 7px 0;
    border-bottom: 1px dashed var(--c-border);
    font-size: .92rem;
  }
  .specs-tight .row:last-of-type { border-bottom: 0; }
  .specs-tight .row.hl { background: #fffbeb; margin: 0 -10px; padding: 9px 10px; border-bottom: 1px solid #fcd34d; border-radius: 4px; }
  .specs-tight dt { color: var(--c-text-dim); margin: 0; }
  .specs-tight dd { margin: 0; font-weight: 600; text-align: right; line-height: 1.35; }
  .mono { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: .92em; }
  abbr {
    text-decoration: underline dotted var(--c-text-faint);
    text-underline-offset: 2px;
    cursor: help;
    color: var(--c-text-faint);
    font-size: 0.85em;
  }

  .kit-note {
    margin-top: 12px;
    padding: 10px 12px;
    background: #f0fdf4;
    border: 1px solid #86efac;
    border-radius: 10px;
    font-size: .88rem;
    line-height: 1.45;
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }
  .kit-ico { font-size: 1.1rem; flex-shrink: 0; }
  .kit-note a { color: var(--c-red); font-weight: 600; }

  /* Articles list */
  .articles-block {
    margin-top: 14px;
    padding: 12px;
    background: linear-gradient(135deg, #fef2f2 0%, #fff7ed 100%);
    border: 1px solid #fecaca;
    border-radius: 10px;
  }
  .articles-title {
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-red);
    margin-bottom: 8px;
  }
  .articles-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .articles-list li {
    display: grid;
    grid-template-columns: minmax(0, auto) 1fr;
    gap: 10px;
    align-items: center;
    padding: 6px 10px;
    background: #fff;
    border: 1px solid #fcd9b6;
    border-radius: 7px;
  }
  .articles-list li.art-current {
    background: var(--c-red);
    color: #fff;
    border-color: var(--c-red);
    box-shadow: 0 2px 8px rgba(229,9,20,0.2);
  }
  .art-num { font-weight: 700; font-size: .98rem; }
  .art-label { font-size: .8rem; color: var(--c-text-dim); }
  .articles-list li.art-current .art-label { color: rgba(255,255,255,0.85); }

  /* Inserts table */
  .inserts-explain {
    margin: 24px 0;
    padding: 18px;
    background: linear-gradient(135deg, #eff6ff 0%, #f0f9ff 100%);
    border: 1px solid #bfdbfe;
    border-radius: 14px;
  }
  .inserts-explain > h2 {
    font-size: .92rem;
    margin: 0 0 14px;
    color: #1e40af;
    font-weight: 700;
  }
  .inserts-table { display: flex; flex-direction: column; gap: 8px; }
  .ins-row {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr);
    gap: 12px;
    padding: 12px 14px;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: 10px;
    align-items: start;
  }
  @media (min-width: 720px) {
    .ins-row {
      grid-template-columns: 60px 180px minmax(0, 1fr);
      align-items: center;
    }
  }
  .ins-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 0;
    border-radius: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: .82rem;
    text-align: center;
    width: 60px;
  }
  .ins-tag-plain { background: #f3f4f6; color: #4b5563; }
  .ins-tag-a { background: #fef3c7; color: #92400e; }
  .ins-tag-g { background: #d1fae5; color: #065f46; }
  .ins-tag-ag { background: var(--c-red); color: #fff; }
  .ins-name { font-weight: 600; font-size: .92rem; grid-column: 2; }
  .ins-desc { font-size: .85rem; color: var(--c-text-dim); line-height: 1.45; grid-column: 2; }
  @media (min-width: 720px) {
    .ins-name { grid-column: 2; }
    .ins-desc { grid-column: 3; }
  }
  .inserts-note { margin-top: 12px; }

  /* INFO row: OEM + Аналоги в 2 колонки */
  .info-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 22px;
  }
  @media (max-width: 640px) {
    .info-row { grid-template-columns: 1fr; gap: 14px; }
  }
  .info-col {
    padding: 16px 18px;
    border-radius: 12px;
  }
  .info-col:nth-child(1) {
    background: linear-gradient(135deg, #f0fdfa 0%, #ecfeff 100%);
    border: 1px solid #99f6e4;
  }
  .info-col:nth-child(2) {
    background: linear-gradient(135deg, #fdf4ff 0%, #fae8ff 100%);
    border: 1px solid #f0abfc;
  }
  .info-col h2 {
    font-size: .82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-dim);
    margin: 0 0 10px;
  }
  .oem-line { display: flex; gap: 10px; margin-bottom: 8px; flex-wrap: wrap; }
  .oem-label {
    font-size: .8rem;
    color: var(--c-text-dim);
    background: var(--c-bg-soft);
    padding: 3px 8px;
    border-radius: 6px;
    flex-shrink: 0;
    align-self: flex-start;
  }
  .oem-vals { display: flex; flex-wrap: wrap; gap: 5px; }
  .oem-vals code {
    background: #f8fafc;
    border: 1px solid var(--c-border);
    padding: 3px 8px;
    border-radius: 6px;
    font-size: .85rem;
    font-family: 'JetBrains Mono', monospace;
  }

  .alt-line { display: flex; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; align-items: center; }
  .alt-label { font-size: .82rem; color: var(--c-text-dim); }
  .alt-chips { display: flex; gap: 5px; flex-wrap: wrap; }
  .alt-chip {
    padding: 4px 10px;
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: 999px;
    font-size: .82rem;
    font-weight: 600;
    color: var(--c-text);
    text-decoration: none;
    transition: all var(--t-fast);
  }
  .alt-chip:hover { border-color: var(--c-red); color: var(--c-red); }

  /* Models */
  .models {
    margin-bottom: 20px;
    padding: 16px 18px;
    background: linear-gradient(135deg, #fef9c3 0%, #fef3c7 100%);
    border: 1px solid #fde68a;
    border-radius: 12px;
  }
  .models h2 {
    font-size: .82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-faint);
    margin: 0 0 8px;
  }
  .models ul {
    padding-left: 18px;
    margin: 0;
    column-count: 2;
    column-gap: 20px;
    line-height: 1.55;
    font-size: .9rem;
  }
  @media (max-width: 540px) { .models ul { column-count: 1; } }

  /* FAQ */
  .faq { margin-bottom: 24px; }
  .faq h2 {
    font-size: .82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-text-faint);
    margin: 0 0 10px;
  }
  .faq-list { display: flex; flex-direction: column; gap: 6px; }
  .faq details {
    border: 1px solid var(--c-border);
    border-radius: 10px;
    background: #fff;
    overflow: hidden;
  }
  .faq summary {
    padding: 12px 16px;
    cursor: pointer;
    font-weight: 600;
    font-size: .92rem;
    list-style: none;
    position: relative;
    padding-right: 40px;
    line-height: 1.4;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: '+';
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.3rem;
    color: var(--c-red);
    transition: transform var(--t-fast);
  }
  .faq details[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  .faq p { padding: 0 16px 14px; margin: 0; color: var(--c-text-dim); font-size: .9rem; line-height: 1.55; }

  /* CTA final */
  .cta-final {
    text-align: center;
    padding: 24px 20px;
    background: linear-gradient(135deg, #fef2f2 0%, #ffedd5 100%);
    border-radius: 14px;
  }
  .cta-final .btn { margin-bottom: 10px; }
  .cta-meta { font-size: .82rem; color: var(--c-text-dim); }

  /* Лого брендов поршней — компактная карточка */
  .brand-logos {
    background: linear-gradient(135deg, #f0fdfa 0%, #ecfeff 100%);
    border: 1px solid #cffafe;
    border-radius: 14px;
    padding: 18px 16px;
    margin: 14px 0;
  }
  .brand-logos > h2 {
    margin: 0 0 12px;
    font-size: 1rem;
    color: #0e7490;
  }
  .bl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 10px;
  }
  .bl-card {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 8px 12px;
  }
  .bl-card img {
    width: 64px;
    height: 32px;
    object-fit: contain;
    flex-shrink: 0;
  }
  .bl-card span {
    font-weight: 600;
    font-size: .9rem;
    line-height: 1.2;
  }
  .bl-card small {
    display: block;
    font-weight: 400;
    font-size: .72rem;
    color: var(--c-text-dim);
  }
</style>
