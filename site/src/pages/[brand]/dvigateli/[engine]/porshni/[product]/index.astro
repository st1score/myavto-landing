---
// Product page для конкретного поршня — одна страница на (engine × parts brand × size × insert type).
// URL: /<brand>/dvigateli/<engine>/porshni/<product>/
// SEO-цель: ранжироваться по точным запросам типа "TEIKIN 46283 STD", "поршень 1KZ TEIKIN", "13101-67030"

import Base from '../../../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../../../components/Breadcrumbs.astro';
import { getEngines, getPistonProductsInStock } from '../../../../../../lib/db';
import { brandSlug, engineSlug } from '../../../../../../lib/slugs';
import { partsBrandLabel } from '../../../../../../lib/labels';
import {
  teikinCatalog,
  RING_POSITION_LABEL,
  RING_SURFACE_LABEL,
  SKIRT_COATING_LABEL,
  CROWN_COATING_LABEL,
  FUEL_LABEL,
} from '../../../../../../data/teikin-catalog';
import { fmtNum } from '../../../../../../lib/format';

export async function getStaticPaths() {
  // Слаги размеров — внутри getStaticPaths, т.к. Astro изолирует контекст
  const SIZE_SLUG: Record<string, string> = {
    'STD': 'std',
    '0.25': '025',
    '0.50': '050',
    '0.75': '075',
    '1.00': '100',
  };
  const brandSlugLower = (brand: string) => brand.toLowerCase().replace(/[^a-z0-9]/g, '-');
  const insertSlug = (it: string) => it === 'plain' ? '' : '-' + it.toLowerCase();

  const [products, engines] = await Promise.all([
    getPistonProductsInStock(),
    getEngines(),
  ]);
  const engByCode = new Map(engines.map((e) => [e.engine_code, e]));

  const paths = [];
  for (const p of products) {
    const eng = engByCode.get(p.engine_code);
    if (!eng) continue;
    const sizeSl = SIZE_SLUG[p.size_code];
    if (!sizeSl) continue;

    let productSlug;
    const teikinEntry = teikinCatalog[p.engine_code];
    if (p.parts_brand === 'TEIKIN' && teikinEntry?.teikin_pistons?.[0]) {
      const article = teikinEntry.teikin_pistons[0].toLowerCase().replace(/[^a-z0-9]+/g, '-');
      productSlug = `teikin-${article}${insertSlug(p.insert_type)}-${sizeSl}`;
    } else {
      productSlug = `${brandSlugLower(p.parts_brand)}${insertSlug(p.insert_type)}-${sizeSl}`;
    }

    paths.push({
      params: {
        brand: brandSlug[eng.brand_name] ?? eng.brand_name.toLowerCase(),
        engine: engineSlug(eng.engine_code),
        product: productSlug,
      },
      props: {
        engine: eng,
        product: p,
        teikinEntry: teikinEntry ?? null,
        // Все продукты этого же двигателя — для блока «Аналоги»
        siblings: products.filter((x) =>
          x.engine_code === p.engine_code &&
          !(x.parts_brand === p.parts_brand && x.size_code === p.size_code && x.insert_type === p.insert_type)
        ),
      },
    });
  }
  return paths;
}

const { engine, product, teikinEntry, siblings } = Astro.props;
const brandSl = brandSlug[engine.brand_name] ?? engine.brand_name.toLowerCase();
const engSl = engineSlug(engine.engine_code);
const sizeLabel = product.size_code;
const partsBrandDisplay = partsBrandLabel[product.parts_brand] ?? product.parts_brand;

// Главный артикул (для TEIKIN)
const mainArticle = product.parts_brand === 'TEIKIN' && teikinEntry?.teikin_pistons?.[0] || '';

const insertDisplay = product.insert_type === 'plain' ? ''
  : product.insert_type === 'AG' ? ' (антизадирная вставка AG)'
  : product.insert_type === 'A' ? ' (вставка типа A)'
  : ` (${product.insert_type})`;

// Готовим аналоги (siblings) — другие бренды/размеры этого же двигателя
const SIZE_SORT_ORDER = ['STD', '0.25', '0.50', '0.75', '1.00'];
function sortKey(s: typeof siblings[number]): string {
  return `${s.parts_brand}|${SIZE_SORT_ORDER.indexOf(s.size_code).toString().padStart(2,'0')}|${s.insert_type}`;
}
const sortedSiblings = [...siblings].sort((a, b) => sortKey(a).localeCompare(sortKey(b)));
const otherSizesSameBrand = sortedSiblings.filter((s) => s.parts_brand === product.parts_brand);
const otherBrandsSameSize = sortedSiblings.filter((s) => s.parts_brand !== product.parts_brand && s.size_code === product.size_code);
const otherBrandsAnySize = sortedSiblings.filter((s) => s.parts_brand !== product.parts_brand && s.size_code !== product.size_code);

// Слаг для ссылки на sibling
function siblingSlug(s: typeof siblings[number]): string {
  const sizeSl = ({ 'STD': 'std', '0.25': '025', '0.50': '050', '0.75': '075', '1.00': '100' } as Record<string, string>)[s.size_code] ?? 'std';
  const ins = s.insert_type === 'plain' ? '' : '-' + s.insert_type.toLowerCase();
  if (s.parts_brand === 'TEIKIN' && teikinEntry?.teikin_pistons?.[0]) {
    const article = teikinEntry.teikin_pistons[0].toLowerCase().replace(/[^a-z0-9]+/g, '-');
    return `teikin-${article}${ins}-${sizeSl}`;
  }
  return `${s.parts_brand.toLowerCase().replace(/[^a-z0-9]/g, '-')}${ins}-${sizeSl}`;
}
function siblingUrl(s: typeof siblings[number]): string {
  return `/${brandSl}/dvigateli/${engSl}/porshni/${siblingSlug(s)}/`;
}

// SEO
const titleParts = [
  `Поршень ${partsBrandDisplay}`,
  mainArticle,
  sizeLabel,
  `на ${engine.brand_name} ${engine.engine_code}`,
];
const seoTitle = titleParts.filter(Boolean).join(' ') + ' — купить в Алматы | MY AVTO';

const seoDescParts: string[] = [];
seoDescParts.push(`Поршень ${partsBrandDisplay}${mainArticle ? ' ' + mainArticle : ''} размер ${sizeLabel}${insertDisplay} на двигатель ${engine.brand_name} ${engine.engine_code}.`);
if (teikinEntry?.bore_mm) seoDescParts.push(`Диаметр поршня Ø${fmtNum(teikinEntry.bore_mm)} мм.`);
if (teikinEntry?.cc) seoDescParts.push(`Двигатель ${teikinEntry.cc} см³, ${teikinEntry.cyl} цилиндра, ${FUEL_LABEL[teikinEntry.fuel]}.`);
if (teikinEntry?.oem_piston?.[0]) seoDescParts.push(`OEM ${teikinEntry.oem_piston[0]}.`);
seoDescParts.push('Цена и наличие — по WhatsApp. Магазин в Алматы, доставка по всему Казахстану.');
const seoDesc = seoDescParts.join(' ');

const seoKw = [
  mainArticle && `TEIKIN ${mainArticle}`,
  mainArticle && `${mainArticle}`,
  `поршень ${engine.engine_code}`,
  `поршень ${engine.engine_code} ${sizeLabel}`,
  `${partsBrandDisplay} ${engine.engine_code}`,
  `${engine.engine_code} ремонтный размер ${sizeLabel}`,
  `капремонт ${engine.engine_code}`,
  ...(teikinEntry?.oem_piston ?? []),
  ...(teikinEntry?.models?.slice(0, 3) ?? []),
].filter(Boolean).join(', ');

// Schema.org
const productJsonLd: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: titleParts.filter(Boolean).join(' '),
  description: seoDesc,
  category: 'Поршни двигателя для капремонта',
  brand: { '@type': 'Brand', name: partsBrandDisplay },
  sku: mainArticle || `${product.parts_brand}-${engine.engine_code}-${sizeLabel}`,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'KZT',
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'AutoPartsStore', name: 'MY AVTO', url: 'https://my-avto.kz' },
  },
};

// FAQ specific to this product
const faqItems = [
  {
    q: `Подойдёт ли поршень ${partsBrandDisplay} ${mainArticle || ''} размер ${sizeLabel} на мой двигатель ${engine.engine_code}?`,
    a: `Да, если двигатель ${engine.engine_code} ${product.size_code === 'STD' ? 'не растачивался — STD стандартный заводской размер' : `растачивался на +${sizeLabel.replace('0.', '')} мм относительно стандарта`}. ${teikinEntry?.bore_mm ? `Номинальный диаметр поршня этого двигателя — Ø${fmtNum(teikinEntry.bore_mm)} мм.` : ''} Точный размер скажет моторист после замера цилиндров.`,
  },
  {
    q: `Чем размер ${sizeLabel} отличается от других?`,
    a: `STD — стандартный (заводской) размер. 0.25 / 0.50 / 0.75 / 1.00 — ремонтные размеры. Цифра означает на сколько миллиметров увеличен диаметр поршня после расточки блока цилиндров. Текущий ${sizeLabel}${product.size_code === 'STD' ? ' = стандарт.' : ` = увеличен на +${sizeLabel.replace('0.', '')} мм.`}`,
  },
  mainArticle ? {
    q: `Что означает артикул ${partsBrandDisplay} ${mainArticle}?`,
    a: `${mainArticle} — каталожный номер TEIKIN для поршня двигателя ${engine.brand_name} ${engine.engine_code}. По этому номеру можно подобрать комплект колец (R ${mainArticle}), палец (P ${mainArticle}), втулку (B ${mainArticle}), гильзу (LFF/LSF ${mainArticle}). Артикулы 46283A / 46283G / 46283AG — модификации того же поршня (другая вставка/обработка).`,
  } : null,
  teikinEntry?.skirt_coating ? {
    q: 'Какое покрытие у этого поршня?',
    a: `Юбка поршня — ${SKIRT_COATING_LABEL[teikinEntry.skirt_coating]}.${teikinEntry.crown_coating && teikinEntry.crown_coating !== 'none' ? ` Днище — ${CROWN_COATING_LABEL[teikinEntry.crown_coating]}.` : ''} Покрытие юбки снижает трение при холодном пуске и износ цилиндра, покрытие днища повышает термостойкость и снижает образование нагара.`,
  } : null,
  {
    q: `Сколько стоит поршень ${partsBrandDisplay} ${mainArticle || ''} ${sizeLabel} на ${engine.engine_code}?`,
    a: `Актуальную цену и наличие пришлём в WhatsApp в течение 10 минут. Цена зависит от партии и курса; работаем напрямую с поставщиками без посредников.`,
  },
].filter(Boolean) as { q: string; a: string }[];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbsJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://my-avto.kz/' },
    { '@type': 'ListItem', position: 2, name: engine.brand_name, item: `https://my-avto.kz/${brandSl}/` },
    { '@type': 'ListItem', position: 3, name: engine.engine_code, item: `https://my-avto.kz/${brandSl}/dvigateli/${engSl}/` },
    { '@type': 'ListItem', position: 4, name: 'Поршни', item: `https://my-avto.kz/${brandSl}/dvigateli/${engSl}/porshni/` },
    { '@type': 'ListItem', position: 5, name: `${partsBrandDisplay} ${mainArticle || sizeLabel}` },
  ],
};

const waText = encodeURIComponent(
  `Здравствуйте! Интересует поршень ${partsBrandDisplay}${mainArticle ? ' ' + mainArticle : ''} ${sizeLabel}${insertDisplay} на двигатель ${engine.brand_name} ${engine.engine_code}. Подскажите цену и наличие.`
);
---
<Base
  title={seoTitle}
  description={seoDesc}
  keywords={seoKw}
  jsonLd={[productJsonLd, breadcrumbsJsonLd, faqJsonLd]}
>
  <div class="container product-page">
    <Breadcrumbs items={[
      { name: 'Главная', href: '/' },
      { name: engine.brand_name, href: `/${brandSl}/` },
      { name: engine.engine_code, href: `/${brandSl}/dvigateli/${engSl}/` },
      { name: 'Поршни', href: `/${brandSl}/dvigateli/${engSl}/porshni/` },
      { name: `${partsBrandDisplay}${mainArticle ? ' ' + mainArticle : ''} ${sizeLabel}` },
    ]} />

    <!-- HERO -->
    <section class="product-hero reveal">
      <div class="ph-tags">
        <span class="ph-tag ph-tag-brand">{partsBrandDisplay}</span>
        {mainArticle && <span class="ph-tag ph-tag-article">№ {mainArticle}</span>}
        <span class="ph-tag">{engine.brand_name} {engine.engine_code}</span>
        <span class="ph-tag ph-tag-size">Размер {sizeLabel}</span>
        {product.insert_type !== 'plain' && <span class="ph-tag ph-tag-insert">{product.insert_type}</span>}
      </div>

      <h1>
        Поршень {partsBrandDisplay}{mainArticle && <> №&nbsp;{mainArticle}</>}<br>
        <span class="h1-sub">размер {sizeLabel}{insertDisplay} — двигатель {engine.brand_name} {engine.engine_code}</span>
      </h1>

      <p class="ph-lead">
        Оригинальный поршень {partsBrandDisplay} {mainArticle && <>артикул <strong class="mono">{mainArticle}</strong> </>}
        для капитального ремонта двигателя <strong>{engine.brand_name} {engine.engine_code}</strong>{teikinEntry?.display_name && teikinEntry.display_name !== `${engine.brand_name} ${engine.engine_code}` && <> ({teikinEntry.display_name})</>}.
        {teikinEntry?.bore_mm && <> Диаметр поршня <strong>Ø{fmtNum(teikinEntry.bore_mm)} мм</strong>,</>}
        {teikinEntry?.cc && <> объём двигателя {teikinEntry.cc} см³ ({fmtNum(teikinEntry.cc / 1000)} л),</>}
        {teikinEntry?.cyl && <> {teikinEntry.cyl} цилиндра</>}{teikinEntry?.fuel && <>, {FUEL_LABEL[teikinEntry.fuel]}</>}.
        Цена и наличие — по WhatsApp.
      </p>

      <div class="hero-cta-row">
        <a href={`https://wa.me/77015509377?text=${waText}`} class="btn btn-lg" target="_blank" rel="noopener noreferrer">
          Узнать цену в WhatsApp
        </a>
        <a href="tel:+77015509377" class="btn btn-lg btn-outline">+7 701 550-93-77</a>
      </div>
    </section>

    <!-- Скан из каталога TEIKIN (если есть) -->
    {teikinEntry?.image && (
      <section class="catalog-block reveal">
        <h2 class="visually-section-h2">Из каталога TEIKIN</h2>
        <div class="catalog-card">
          <img src={teikinEntry.image} alt={`Поршень ${partsBrandDisplay} ${mainArticle} ${sizeLabel} на ${engine.brand_name} ${engine.engine_code} — оригинальная страница каталога TEIKIN`} loading="lazy" />
          <div class="catalog-caption muted small">
            Скан из официального каталога TEIKIN Vol.&nbsp;22 (2022), стр.&nbsp;{teikinEntry.catalog_page}
          </div>
        </div>
      </section>
    )}

    <!-- ТЕХ. ХАРАКТЕРИСТИКИ — 4 группы -->
    <div class="spec-groups">

      <section class="spec-group reveal">
        <h2>Двигатель</h2>
        <dl class="kv">
          <div><dt>Марка</dt><dd>{engine.brand_name}</dd></div>
          <div><dt>Код двигателя</dt><dd class="mono"><strong>{engine.engine_code}</strong></dd></div>
          {teikinEntry?.display_name && (
            <div><dt>Полное обозначение</dt><dd>{teikinEntry.display_name}</dd></div>
          )}
          {teikinEntry?.cc && (
            <div><dt>Объём</dt><dd>{teikinEntry.cc} см³ ({fmtNum(teikinEntry.cc / 1000)} л)</dd></div>
          )}
          {teikinEntry?.cyl && (
            <div><dt>Цилиндров</dt><dd>{teikinEntry.cyl}</dd></div>
          )}
          {teikinEntry?.fuel && (
            <div><dt>Топливо</dt><dd>{FUEL_LABEL[teikinEntry.fuel]}</dd></div>
          )}
        </dl>
      </section>

      <section class="spec-group reveal">
        <h2>Поршень</h2>
        <dl class="kv">
          <div><dt>Артикул TEIKIN</dt><dd class="mono"><strong>{mainArticle || '—'}</strong></dd></div>
          {teikinEntry?.teikin_pistons && teikinEntry.teikin_pistons.length > 1 && (
            <div>
              <dt>Альтернативные арт.</dt>
              <dd class="mono">{teikinEntry.teikin_pistons.slice(1).join(' / ')}</dd>
            </div>
          )}
          <div><dt>Ремонтный размер</dt><dd><strong>{sizeLabel}</strong>{product.size_code !== 'STD' && <> ({sizeLabel.replace('0.', '+')} мм)</>}</dd></div>
          {teikinEntry?.bore_mm && (
            <div>
              <dt>Диаметр поршня</dt>
              <dd>Ø {fmtNum(teikinEntry.bore_mm)} мм{teikinEntry.bore_undersize_mm && <> <span class="muted small">(допуск {fmtNum(teikinEntry.bore_undersize_mm)})</span></>}</dd>
            </div>
          )}
          {teikinEntry?.cd_mm && (
            <div>
              <dt>Высота сжатия <span class="abbr">(CD)</span></dt>
              <dd>{fmtNum(teikinEntry.cd_mm)} мм<div class="help muted small">от центра пальца до днища поршня</div></dd>
            </div>
          )}
          {teikinEntry?.tl_mm && (
            <div>
              <dt>Полная высота <span class="abbr">(TL)</span></dt>
              <dd>{fmtNum(teikinEntry.tl_mm)} мм<div class="help muted small">общая высота поршня</div></dd>
            </div>
          )}
          {teikinEntry?.skirt_coating && (
            <div>
              <dt>Покрытие юбки</dt>
              <dd>{SKIRT_COATING_LABEL[teikinEntry.skirt_coating]}</dd>
            </div>
          )}
          {teikinEntry?.crown_coating && teikinEntry.crown_coating !== 'none' && (
            <div>
              <dt>Покрытие днища</dt>
              <dd>{CROWN_COATING_LABEL[teikinEntry.crown_coating]}</dd>
            </div>
          )}
          {teikinEntry?.mrc_mm && (
            <div>
              <dt>Зазор поршень-гильза <span class="abbr">(MRC)</span></dt>
              <dd>{fmtNum(teikinEntry.mrc_mm)} мм<div class="help muted small">максимально допустимый</div></dd>
            </div>
          )}
          {teikinEntry?.mp_mm && (
            <div>
              <dt>Точка измерения <span class="abbr">(MP)</span></dt>
              <dd>{fmtNum(teikinEntry.mp_mm)} мм<div class="help muted small">высота, где меряется диаметр</div></dd>
            </div>
          )}
        </dl>
      </section>

      {teikinEntry?.rings && teikinEntry.rings.length > 0 && (
        <section class="spec-group spec-group-rings reveal">
          <h2>Поршневые кольца в комплекте</h2>
          <p class="muted small group-help">Толщина и тип каждого кольца. Артикул комплекта: <strong class="mono">{teikinEntry.teikin_rings_set || '—'}</strong></p>
          <div class="rings-grid">
            {teikinEntry.rings.map((r, i) => (
              <div class={`ring-card ring-${r.position}`}>
                <div class="ring-num">{i + 1}</div>
                <div class="ring-body">
                  <div class="ring-thickness mono">{fmtNum(r.thickness_mm)} мм</div>
                  <div class="ring-position">{RING_POSITION_LABEL[r.position]}</div>
                  {r.surface && <div class="ring-surface muted small">{RING_SURFACE_LABEL[r.surface]}</div>}
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      {(teikinEntry?.pin_diameter_mm || teikinEntry?.pin_total_length_mm || teikinEntry?.liner_od_mm) && (
        <section class="spec-group reveal">
          <h2>Палец, втулка и гильза</h2>
          <dl class="kv">
            {teikinEntry.pin_diameter_mm && (
              <div><dt>Диаметр пальца</dt><dd>Ø {fmtNum(teikinEntry.pin_diameter_mm)} мм</dd></div>
            )}
            {teikinEntry.pin_total_length_mm && (
              <div>
                <dt>Длина пальца <span class="abbr">(TL)</span></dt>
                <dd>{fmtNum(teikinEntry.pin_total_length_mm)} мм</dd>
              </div>
            )}
            {teikinEntry.teikin_pin && (
              <div><dt>Артикул пальца</dt><dd class="mono">{teikinEntry.teikin_pin}</dd></div>
            )}
            {teikinEntry.teikin_bushing && (
              <div><dt>Артикул втулки</dt><dd class="mono">{teikinEntry.teikin_bushing}</dd></div>
            )}
            {teikinEntry.liner_total_length_mm && (
              <div><dt>Длина гильзы</dt><dd>{fmtNum(teikinEntry.liner_total_length_mm)} мм</dd></div>
            )}
            {teikinEntry.liner_od_mm && (
              <div><dt>Внешний Ø гильзы</dt><dd>{fmtNum(teikinEntry.liner_od_mm)} мм</dd></div>
            )}
            {teikinEntry.liner_flange_thickness_mm && (
              <div><dt>Толщина фланца гильзы</dt><dd>{fmtNum(teikinEntry.liner_flange_thickness_mm)} мм</dd></div>
            )}
            {teikinEntry.liner_flange_diameter_mm && (
              <div><dt>Ø фланца гильзы</dt><dd>{fmtNum(teikinEntry.liner_flange_diameter_mm)} мм</dd></div>
            )}
            {teikinEntry.teikin_liner_flanged && (
              <div><dt>Артикул гильзы с фланцем</dt><dd class="mono">{teikinEntry.teikin_liner_flanged}</dd></div>
            )}
            {teikinEntry.teikin_liner_no_flange && (
              <div><dt>Артикул гильзы без фланца</dt><dd class="mono">{teikinEntry.teikin_liner_no_flange}</dd></div>
            )}
          </dl>
        </section>
      )}
    </div>

    <!-- OEM номера -->
    {(teikinEntry?.oem_piston?.length || teikinEntry?.oem_rings?.length || teikinEntry?.oem_pin?.length) && (
      <section class="reveal">
        <h2>Каталожные номера (OEM)</h2>
        <p class="muted small">Оригинальные номера для проверки совместимости в дилерском каталоге или у моториста.</p>
        <div class="oem-grid">
          {teikinEntry.oem_piston?.length ? (
            <div class="oem-block">
              <div class="oem-title">Поршень</div>
              <div class="oem-list">{teikinEntry.oem_piston.map((o) => <span class="oem-num mono">{o}</span>)}</div>
            </div>
          ) : null}
          {teikinEntry.oem_rings?.length ? (
            <div class="oem-block">
