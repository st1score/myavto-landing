---
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { getEngines, getEnginePartsIndex, getPartNumbers, getAttributes } from '../../../../lib/db';
import { brandSlug, engineSlug } from '../../../../lib/slugs';
import { fmtNum } from '../../../../lib/format';
import { teikinCatalog, FUEL_LABEL } from '../../../../data/teikin-catalog';

export async function getStaticPaths() {
  const engines = await getEngines();
  const partsIdx = await getEnginePartsIndex();
  const byEngine = new Map<string, string[]>();
  for (const p of partsIdx) {
    const arr = byEngine.get(p.engine_code) ?? [];
    arr.push(p.category_code);
    byEngine.set(p.engine_code, arr);
  }
  return engines.map((e) => ({
    params: {
      brand: brandSlug[e.brand_name] ?? e.brand_name.toLowerCase(),
      engine: engineSlug(e.engine_code),
    },
    props: { engine: e, categories: byEngine.get(e.engine_code) ?? [] },
  }));
}

const { engine, categories } = Astro.props;

const [pistonNumbers, ringNumbers, pistonAttrs] = await Promise.all([
  getPartNumbers(engine.engine_code, 'PISTON'),
  getPartNumbers(engine.engine_code, 'RING'),
  getAttributes(engine.engine_code, 'PISTON'),
]);

const attrMap = Object.fromEntries(
  pistonAttrs.map((a) => [a.attribute_code, a.value_text ?? a.value_number ?? a.value_integer])
);

const oemPistons = pistonNumbers.filter((n) => n.number_type === 'oem' || n.number_type === 'alt_oem');
const tknPistons = pistonNumbers.filter((n) => n.number_type === 'teikin');
const oemRings = ringNumbers.filter((n) => n.number_type === 'oem');

const brandSl = brandSlug[engine.brand_name] ?? engine.brand_name.toLowerCase();
const engSl = engineSlug(engine.engine_code);
const teikinEntry = teikinCatalog[engine.engine_code];
const heroImg = teikinEntry?.image ?? '/teikin-photos/piston-sample.png';

const seoTitle = `Запчасти на двигатель ${engine.brand_name} ${engine.engine_code} купить в Алматы | MY AVTO`;
const seoDesc = `Запчасти на ${engine.brand_name} ${engine.engine_code}${engine.volume_l ? `, ${fmtNum(engine.volume_l)} л` : ''}: поршни, кольца, вкладыши, прокладки. Бренды TEIKIN, NPR, IZUMI. Все ремонтные размеры. Цена и наличие — в WhatsApp.`;
const seoKw = [
  `${engine.engine_code.toLowerCase()} запчасти`,
  `запчасти ${engine.engine_code.toLowerCase()}`,
  `${engine.engine_code.toLowerCase()} поршни`,
  `${engine.engine_code.toLowerCase()} кольца`,
  `${engine.engine_code.toLowerCase()} вкладыши`,
  `${engine.engine_code.toLowerCase()} капремонт`,
  `${engine.brand_name.toLowerCase()} ${engine.engine_code.toLowerCase()}`,
].join(', ');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://my-avto.kz/' },
      { '@type': 'ListItem', position: 2, name: engine.brand_name, item: `https://my-avto.kz/${brandSl}/` },
      { '@type': 'ListItem', position: 3, name: engine.engine_code },
    ],
  },
];

const categoryCards = [
  categories.includes('PISTON') && {
    title: 'Поршни',
    subtitle: 'TEIKIN, ND, IZUMI, NM',
    href: `/${brandSl}/dvigateli/${engSl}/porshni/`,
    icon: 'piston',
  },
  categories.includes('RING') && {
    title: 'Кольца',
    subtitle: 'RIK, TP, NPR',
    href: `/${brandSl}/dvigateli/${engSl}/koltsa-porshnevye/`,
    icon: 'rings',
  },
  {
    title: 'Вкладыши',
    subtitle: 'Taiho, NDC',
    href: '/zapchasti/vkladyshi/',
    icon: 'bearing',
  },
  {
    title: 'Подбор',
    subtitle: 'по VIN или фото',
    href: `https://wa.me/77015509377?text=${encodeURIComponent(`Здравствуйте! Нужны запчасти на двигатель ${engine.brand_name} ${engine.engine_code}.`)}`,
    icon: 'search',
  },
].filter(Boolean) as { title: string; subtitle: string; href: string; icon: string }[];
---

<Base
  title={seoTitle}
  description={seoDesc}
  keywords={seoKw}
  jsonLd={jsonLd}
  stickyWaText={`Здравствуйте! Нужны запчасти на двигатель ${engine.brand_name} ${engine.engine_code}. Подскажите наличие.`}
>
  <main class="engine-screen">
    <div class="container">
      <Breadcrumbs items={[
        { name: 'Главная', href: '/' },
        { name: engine.brand_name, href: `/${brandSl}/` },
        { name: engine.engine_code },
      ]} />

      <section class="engine-hero">
        <div class="engine-visual">
          <img src={heroImg} alt={`Каталог TEIKIN ${engine.engine_code}`} loading="eager" />
          <span class="stock-pill">В наличии</span>
        </div>

        <div class="engine-info">
          <p class="engine-kicker">{engine.brand_name}</p>
          <h1>Двигатель {engine.engine_code}</h1>
          <p class="engine-lead">
            Запчасти для капремонта: поршни, кольца, вкладыши и прокладки. Подбор по OEM, артикулу или параметрам.
          </p>

          <div class="engine-specs">
            {engine.volume_l && <div><span>Объём</span><b>{fmtNum(engine.volume_l)} л</b></div>}
            {engine.cylinder_count && <div><span>Цилиндров</span><b>{engine.cylinder_count}</b></div>}
            {engine.valve_count && <div><span>Клапанов</span><b>{engine.valve_count}</b></div>}
            <div><span>Топливо</span><b>{teikinEntry?.fuel ? FUEL_LABEL[teikinEntry.fuel] : (engine.is_diesel ? 'Дизель' : 'Бензин')}</b></div>
            {attrMap.piston_diameter && <div><span>Диаметр</span><b>Ø {fmtNum(attrMap.piston_diameter)} мм</b></div>}
            {attrMap.pin_diameter && <div><span>Палец</span><b>Ø {fmtNum(attrMap.pin_diameter)} мм</b></div>}
          </div>

          <a href={`https://wa.me/77015509377?text=${encodeURIComponent(`Здравствуйте! Нужны запчасти на двигатель ${engine.brand_name} ${engine.engine_code}. Подскажите наличие и цену.`)}`} target="_blank" rel="noopener noreferrer" class="btn engine-main-cta">
            Подобрать запчасти
          </a>
        </div>
      </section>

      <section class="engine-section">
        <div class="engine-section-head">
          <h2>Каталог запчастей</h2>
          <span>{categoryCards.length} раздела</span>
        </div>
        <div class="engine-category-grid">
          {categoryCards.map((card) => (
            <a href={card.href} class="engine-category-card" target={card.href.startsWith('http') ? '_blank' : undefined} rel={card.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
              <span class="engine-cat-icon" data-icon={card.icon}></span>
              <strong>{card.title}</strong>
              <small>{card.subtitle}</small>
            </a>
          ))}
        </div>
      </section>

      {(oemPistons.length > 0 || tknPistons.length > 0 || oemRings.length > 0) && (
        <section class="engine-section engine-details">
          <h2>Каталожные номера</h2>
          <div class="engine-number-list">
            {oemPistons.length > 0 && (
              <details open>
                <summary>OEM поршней</summary>
                <div>{oemPistons.map((n) => <code>{n.number_value}</code>)}</div>
              </details>
            )}
            {tknPistons.length > 0 && (
              <details>
                <summary>TEIKIN</summary>
                <div>{tknPistons.map((n) => <code>{n.number_value}</code>)}</div>
              </details>
            )}
            {oemRings.length > 0 && (
              <details>
                <summary>OEM колец</summary>
                <div>{oemRings.map((n) => <code>{n.number_value}</code>)}</div>
              </details>
            )}
          </div>
        </section>
      )}
    </div>
  </main>
</Base>

<style>
  .engine-screen {
    background: #fff;
    padding: 18px 0 36px;
  }

  .engine-hero {
    display: grid;
    grid-template-columns: minmax(320px, .95fr) minmax(0, 1fr);
    gap: 34px;
    align-items: center;
    padding: 28px 0 14px;
  }

  .engine-visual {
    position: relative;
    min-height: 340px;
    display: grid;
    place-items: center;
    border-radius: 24px;
    background: linear-gradient(180deg, #fff, #f8f8f9);
  }

  .engine-visual img {
    width: min(100%, 520px);
    max-height: 320px;
    object-fit: contain;
    filter: drop-shadow(0 24px 34px rgba(15, 23, 42, .12));
  }

  .stock-pill {
    position: absolute;
    left: 18px;
    top: 18px;
    padding: 7px 12px;
    border-radius: 999px;
    background: #e7f8ee;
    color: #118447;
    font-size: .86rem;
    font-weight: 800;
  }

  .stock-pill::before {
    content: "";
    width: 8px;
    height: 8px;
    display: inline-block;
    margin-right: 7px;
    border-radius: 50%;
    background: #16a34a;
  }

  .engine-kicker {
    margin: 0 0 8px;
    color: var(--c-red);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .engine-info h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1;
  }

  .engine-lead {
    max-width: 520px;
    margin: 16px 0 0;
    color: var(--c-text-dim);
    font-size: 1.02rem;
  }

  .engine-specs {
    margin: 24px 0;
    border-top: 1px solid var(--c-border);
  }

  .engine-specs div {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding: 13px 0;
    border-bottom: 1px solid var(--c-border);
  }

  .engine-specs span {
    color: var(--c-text-faint);
  }

  .engine-specs b {
    text-align: right;
  }

  .engine-main-cta {
    width: min(100%, 360px);
    min-height: 56px;
  }

  .engine-section {
    padding: 26px 0 4px;
  }

  .engine-section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-bottom: 14px;
  }

  .engine-section-head h2,
  .engine-details h2 {
    margin: 0;
    font-size: clamp(1.35rem, 3vw, 2rem);
  }

  .engine-section-head span {
    color: var(--c-red);
    font-size: .9rem;
    font-weight: 800;
  }

  .engine-category-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .engine-category-card {
    min-height: 128px;
    padding: 18px 12px;
    border: 1px solid var(--c-border);
    border-radius: 16px;
    background: linear-gradient(180deg, #fff, #fbfbfc);
    display: grid;
    place-items: center;
    gap: 8px;
    text-align: center;
  }

  .engine-category-card strong {
    font-size: .95rem;
  }

  .engine-category-card small {
    color: var(--c-text-faint);
    font-size: .78rem;
  }

  .engine-cat-icon {
    width: 34px;
    height: 34px;
    display: block;
    background: var(--c-text);
    mask: var(--icon) center / contain no-repeat;
    -webkit-mask: var(--icon) center / contain no-repeat;
  }

  .engine-cat-icon[data-icon="piston"] { --icon: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M8 5h8v6a4 4 0 0 1-8 0zM7 5h10M9 16h6M10 19h4' fill='none' stroke='black' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"); }
  .engine-cat-icon[data-icon="rings"] { --icon: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='9' cy='12' r='5' fill='none' stroke='black' stroke-width='1.8'/%3E%3Ccircle cx='15' cy='12' r='5' fill='none' stroke='black' stroke-width='1.8'/%3E%3C/svg%3E"); }
  .engine-cat-icon[data-icon="bearing"] { --icon: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M5 7h14v10H5zM8 7V5h8v2M8 17v2h8v-2M9 10h6M9 14h6' fill='none' stroke='black' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"); }
  .engine-cat-icon[data-icon="search"] { --icon: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='10.5' cy='10.5' r='6' fill='none' stroke='black' stroke-width='1.8'/%3E%3Cpath d='M15 15l5 5M10.5 7.5v6M7.5 10.5h6' fill='none' stroke='black' stroke-width='1.8' stroke-linecap='round'/%3E%3C/svg%3E"); }

  .engine-number-list {
    display: grid;
    gap: 10px;
    margin-top: 14px;
  }

  .engine-number-list details {
    border: 1px solid var(--c-border);
    border-radius: 14px;
    background: #fff;
    overflow: hidden;
  }

  .engine-number-list summary {
    cursor: pointer;
    padding: 15px 16px;
    font-weight: 900;
    list-style: none;
  }

  .engine-number-list summary::-webkit-details-marker {
    display: none;
  }

  .engine-number-list details > div {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 16px 16px;
  }

  .engine-number-list code {
    padding: 6px 9px;
    border-radius: 9px;
    background: var(--c-bg-soft);
    color: var(--c-text);
  }

  @media (max-width: 900px) {
    .engine-screen {
      padding-top: 8px;
    }

    .engine-hero {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding-top: 14px;
    }

    .engine-visual {
      min-height: 240px;
      border-radius: 18px;
    }

    .engine-visual img {
      max-height: 220px;
    }

    .engine-info h1 {
      font-size: 2rem;
    }

    .engine-lead {
      font-size: .96rem;
    }

    .engine-category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .engine-category-card {
      min-height: 112px;
    }
  }
</style>
