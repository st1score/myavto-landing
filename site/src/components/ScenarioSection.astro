---
import { CONTACTS } from '../lib/contacts';

const vinText = 'Здравствуйте! Хочу подобрать запчасти для капиталки двигателя. Код двигателя не знаю. Могу отправить VIN/марку/модель.';
const vinHref = CONTACTS.whatsappWithText(vinText);
---

<section class="scenario-section" id="scenario" aria-labelledby="scenario-title">
  <div class="container">
    <div class="section-title reveal">
      <span class="eyebrow">Начните здесь</span>
      <h2 id="scenario-title">Как вам удобнее подобрать запчасти?</h2>
    </div>

    <div class="scenario-grid">
      <a class="scenario-card reveal tap-press" href="#picker">
        <div class="scenario-num">01</div>
        <h3>Я знаю код двигателя</h3>
        <p>Введите 1KZ, 4D56, 2AZ, VQ35DE или другой код мотора и выберите нужные детали.</p>
        <span class="scenario-cta">Выбрать двигатель →</span>
      </a>

      <a class="scenario-card reveal reveal-delay-1 tap-press" href={vinHref} target="_blank" rel="noopener">
        <div class="scenario-num scenario-num-accent">02</div>
        <h3>Я не знаю код двигателя</h3>
        <p>Пришлите VIN, марку/модель или фото шильдика — подберём вручную.</p>
        <span class="scenario-cta">Подобрать по VIN →</span>
      </a>

      <a class="scenario-card reveal reveal-delay-2 tap-press" href="#parts-categories">
        <div class="scenario-num">03</div>
        <h3>Нужна конкретная деталь</h3>
        <p>Поршни, кольца, вкладыши, прокладка ГБЦ или гильзы под ваш мотор.</p>
        <span class="scenario-cta">Выбрать категорию →</span>
      </a>
    </div>
  </div>
</section>

<style>
  .scenario-section { background: var(--c-bg); }
  .scenario-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .scenario-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    min-height: 200px;
    background: var(--c-bg-card);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    color: inherit;
    transition: border-color var(--t-med), box-shadow var(--t-med), transform var(--t-med);
    min-height: 44px;
  }
  @media (hover: hover) and (pointer: fine) {
    .scenario-card:hover {
      border-color: var(--c-black);
      box-shadow: var(--shadow-lg);
      transform: translateY(-4px);
      color: inherit;
    }
    .scenario-card:hover .scenario-cta { color: var(--c-red); }
  }
  .scenario-num {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 1rem;
    font-weight: 700;
    color: var(--c-text-faint);
    letter-spacing: 0.05em;
  }
  .scenario-num-accent { color: var(--c-red); }
  .scenario-card h3 {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .scenario-card p {
    color: var(--c-text-dim);
    font-size: 0.98rem;
    line-height: 1.5;
    margin: 0;
    flex-grow: 1;
  }
  .scenario-cta {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--c-black);
    margin-top: 8px;
    transition: color var(--t-fast);
  }
  @media (max-width: 900px) {
    .scenario-grid { grid-template-columns: 1fr; gap: 14px; }
    .scenario-card { padding: 22px; min-height: 0; }
  }
</style>
