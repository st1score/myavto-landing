---
import { CONTACTS } from '../lib/contacts';
import Logo from './Logo.astro';
const waUrl = CONTACTS.whatsappWithText('Здравствуйте! Нужна помощь с подбором запчастей для двигателя.');
---
<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a href="/" class="header-logo" aria-label="MY AVTO — главная">
      <Logo size={40} variant="light" />
    </a>
    <nav class="nav" aria-label="Главная навигация">
      <a href="/search/">Каталог</a>
      <a href="/search/?category=PISTON">Поршни</a>
      <a href="/search/?category=RING">Кольца</a>
      <a href="/search/?category=BEARING">Вкладыши</a>
      <a href="/search/?category=LINER">Гильзы</a>
    </nav>
    <div class="header-actions">
      <a href="tel:+77015509377" class="phone-link" aria-label="Позвонить">
        <span class="phone-dot"></span>+7 701 550-93-77
      </a>
      <a href={waUrl} class="btn btn-sm" target="_blank" rel="noopener">WhatsApp</a>
    </div>
    <a href="/search/" class="icon-action search-action" aria-label="Поиск">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
    </a>
    <button class="burger" id="burger" aria-label="Меню">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-menu" id="mobile-menu">
    <a href="/search/">Весь каталог</a>
    <a href="/search/?category=PISTON">Поршни</a>
    <a href="/search/?category=RING">Кольца</a>
    <a href="/search/?category=BEARING">Вкладыши</a>
    <a href="/search/?category=LINER">Гильзы</a>
    <a href="/search/?category=KIT">Ремкомплекты</a>
    <a href="tel:+77015509377" class="phone-mobile">📞 +7 701 550-93-77</a>
    <a href={waUrl} class="btn" target="_blank" rel="noopener" style="margin-top: 8px;">WhatsApp</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255,255,255,0.98);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    transition: background var(--t-fast), box-shadow var(--t-fast);
  }
  .site-header.scrolled { background: #fff; box-shadow: var(--shadow-sm); }
  @media (max-width: 900px) {
    .site-header { background: #fff; backdrop-filter: none; -webkit-backdrop-filter: none; }
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 14px 24px;
  }
  @media (max-width: 640px) { .header-inner { padding: 14px 16px; gap: 14px; } }
  .header-logo { flex-shrink: 0; display: flex; align-items: center; }
  :global(.site-header .myavto-logo) { flex-shrink: 0; }
  @media (max-width: 640px) { :global(.site-header .myavto-logo svg) { height: 34px; } }

  .nav { display: flex; align-items: center; gap: 24px; flex: 1; justify-content: center; }
  .nav a {
    color: var(--c-text);
    font-size: .94rem;
    font-weight: 500;
  }
  .nav a:hover { color: var(--c-red); }

  .header-actions { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }
  .icon-action { width: 44px; height: 44px; display: none; align-items: center; justify-content: center; color: var(--c-text); border-radius: 999px; }
  .phone-link { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: .92rem; color: var(--c-text); }
  .phone-link:hover { color: var(--c-red); }
  .phone-dot { width: 8px; height: 8px; background: var(--c-red); border-radius: 50%; }

  .burger { display: none; background: transparent; border: 0; cursor: pointer; width: 44px; height: 44px; padding: 0; flex-direction: column; justify-content: center; gap: 5px; align-items: center; }
  .burger span { display: block; width: 22px; height: 2px; background: var(--c-black); border-radius: 2px; transition: transform var(--t-fast), opacity var(--t-fast); }
  .burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .burger.open span:nth-child(2) { opacity: 0; }
  .burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-menu { display: none; flex-direction: column; gap: 2px; padding: 12px 16px 20px; border-top: 1px solid var(--c-border); background: #fff; max-height: calc(100dvh - 70px); overflow-y: auto; }
  .mobile-menu a { padding: 14px 4px; font-size: 1.05rem; font-weight: 500; min-height: 48px; display: flex; align-items: center; }
  .phone-mobile { color: var(--c-text); font-weight: 600; margin-top: 12px; border-top: 1px solid var(--c-border); }
  .mobile-menu.open { display: flex; }
  body.menu-open { overflow: hidden; }

  @media (max-width: 1100px) { .header-actions .phone-link { display: none; } }
  @media (max-width: 900px) {
    .nav { display: none; }
    .burger { display: flex; }
    .header-actions { display: none; }
    .search-action { display: inline-flex; }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 8) header.classList.add('scrolled');
    else header.classList.remove('scrolled');
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobile-menu');
  function toggleMenu(force?: boolean) {
    const isOpen = force ?? !burger?.classList.contains('open');
    burger?.classList.toggle('open', isOpen);
    menu?.classList.toggle('open', isOpen);
    document.body.classList.toggle('menu-open', isOpen);
  }
  burger?.addEventListener('click', () => toggleMenu());
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggleMenu(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') toggleMenu(false); });
</script>
