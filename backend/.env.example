# Copy to .env and fill. NEVER commit .env (it holds the DB password).
#
# Supabase Postgres connection string:
#   Supabase Dashboard -> Settings -> Database -> Connection string -> URI
# Use the DIRECT connection (port 5432) for migrations, or the pooler for runtime.
# Example shape (DO NOT paste a real password into git):
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Django
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origin allowed to call the API (Next.js dev + prod)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://my-avto.kz

# Schema where Django creates its OWN system tables (auth, sessions, admin).
# Kept separate so we never collide with the owner-managed `public` schema.
DJANGO_SYSTEM_SCHEMA=django
