# Directus local admin — copy to .env.directus and fill in
# Generate KEY/SECRET: `uuidgen` twice on macOS, or `openssl rand -hex 16`

KEY=replace-with-uuid-v4
SECRET=replace-with-long-random-secret

ADMIN_EMAIL=sementrachuk@gmail.com
ADMIN_PASSWORD=change-me-on-first-run

# Supabase pooler connection string (same as site .env DATABASE_URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
