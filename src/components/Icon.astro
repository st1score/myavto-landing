---
// Простые линейные иконки. name: phone | wa | menu | pin | chev | check
const { name, size = 20, stroke = 'currentColor', width = 2 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke={stroke} stroke-width={width} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'phone' && <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" />}
  {name === 'wa' && <><path d="M3.5 20.5l1.3-4A8.5 8.5 0 1 1 8 19.6z" /><path d="M9 9.5c.3 1.8 1.7 3.6 3.5 4.5l1.3-1 2 1-.4 1.4c-3.3.3-7-3.3-7.4-6.6L9.4 8l1 2z" /></>}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'pin' && <><path d="M12 22s7-6.2 7-12a7 7 0 0 0-14 0c0 5.8 7 12 7 12z" /><circle cx="12" cy="10" r="2.5" /></>}
  {name === 'chev' && <path d="M6 9l6 6 6-6" />}
  {name === 'check' && <path d="M5 12.5l4.5 4.5L19 7.5" />}
</svg>
