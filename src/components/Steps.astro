---
const steps = [
  { t: 'Пишете в WhatsApp', d: 'Какая деталь нужна. Можно сразу VIN или фото старой детали.' },
  { t: 'Сверяем по VIN', d: 'Проверяем номер детали по каталогу, при сомнениях — по фото.' },
  { t: 'Присылаем варианты', d: 'Оригинал и аналоги с ценой и сроком — выбираете сами.' },
  { t: 'Забираете или доставка', d: 'В бутике в ТЦ CarCity или доставкой по Казахстану.' },
];
---
<section class="sec" id="kak-rabotaem">
  <h2>Как мы работаем</h2>
  <ol class="steps">
    {steps.map((s, i) => (
      <li><span class="num">{i + 1}</span><div><strong>{s.t}</strong><span>{s.d}</span></div></li>
    ))}
  </ol>
</section>
