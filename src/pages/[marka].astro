---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import QuickForm from '../components/QuickForm.astro';
import Facts from '../components/Facts.astro';
import Steps from '../components/Steps.astro';
import Cats from '../components/Cats.astro';
import Faq from '../components/Faq.astro';
import Contacts from '../components/Contacts.astro';
import { SITE, waLink, CATS } from '../data/site';

export async function getStaticPaths() {
  const list = await getCollection('marki');
  return list.map((entry) => ({ params: { marka: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const url = `${SITE.url}/${entry.id}/`;
const crumbsLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: `Запчасти ${d.name}`, item: url },
  ],
};
const popular = d.cats.map((s) => CATS.find((c) => c.slug === s)).filter(Boolean);
---
<Base title={d.title} description={d.description} jsonld={[crumbsLd]} waFirst={`Здравствуйте! Нужна запчасть на ${d.name}.`}>
  <Hero h1={d.h1} lead={d.lead} waFirst={`Здравствуйте! Нужна запчасть на ${d.name}.`} crumbs={[{ href: '', name: d.name }]} />
  <QuickForm car={d.name + ' '} />
  <Facts />

  <section class="sec">
    <h2>Популярные модели {d.name}</h2>
    <div class="chips">
      {d.models.map((m) => (
        <a class="chip" href={waLink(`Здравствуйте! Нужна запчасть на ${d.name} ${m}.\n— с сайта my-avto.kz/${entry.id}/`)}>{m}</a>
      ))}
    </div>
    {d.engines.length > 0 && (
      <>
        <p class="small muted" style="font-weight:700">Двигатели, под которые часто подбираем</p>
        <div class="chips">{d.engines.map((e) => <span class="chip chip--mono">{e}</span>)}</div>
      </>
    )}
  </section>

  {popular.length > 0 && (
    <section class="sec">
      <h2>Что чаще всего берут на {d.name}</h2>
      <div class="grid2">
        {popular.map((c) => (
          <a class="cat" href={`/zapchasti/${c!.slug}/`}><strong>{c!.name}</strong><span>{c!.short}</span></a>
        ))}
      </div>
    </section>
  )}

  <section class="sec">
    <div class="card prose"><Content /></div>
  </section>

  <Steps />
  <Faq items={d.faq} title={`Вопросы про запчасти ${d.name}`} />
  <Cats title="Все группы запчастей" />
  <Contacts />
</Base>
